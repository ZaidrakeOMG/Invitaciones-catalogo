---
import '../styles/global.css';
import '../styles/catalog-extra.css';
import '../styles/visual-fix.css';
import '../styles/portfolio-refresh.css';
import '../styles/studio-redesign.css';
import '../styles/cazami-mobile-luxe.css';
import '../styles/android-desktop-fit.css';
import {site,contactHref} from '../data/site';
import UiIcon from '../components/UiIcon.astro';
interface Props {title?:string;description?:string;image?:string;noindex?:boolean}
const {title=site.title,description=site.description,image='/og-cover.png',noindex=false}=Astro.props;
const origin=import.meta.env.PUBLIC_SITE_URL||Astro.site?.toString();
const canonical=origin?new URL(Astro.url.pathname,origin).toString():undefined;
const og=origin?new URL(image,origin).toString():undefined;
---
<!doctype html><html lang="es"><head>
<meta charset="utf-8"/>{noindex && <meta name="robots" content="noindex,nofollow"/>}<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
{Astro.url.pathname === '/' && <script is:inline>
  (function(){
    // Versión PC a escala para teléfonos: Android, iPhone y navegadores con
    // identificación de escritorio pero pantalla táctil pequeña.
    var params=new URLSearchParams(window.location.search);
    var requested=params.get('vista');
    var handheld=/Android|iPhone|iPod|Mobile/i.test(navigator.userAgent)
      || (navigator.maxTouchPoints>0 && Math.min(screen.width,screen.height)<=820);
    // Clave v2 para dejar de reutilizar la preferencia móvil del diseño antiguo.
    var key='cazami-catalogo-vista-v2',saved='';
    try{saved=localStorage.getItem(key)||'';}catch(e){}
    var forced=requested==='pc'||requested==='movil'?requested:'';
    var mode=forced||saved||(handheld?'pc':'movil');
    var useDesktop=mode==='pc';
    var root=document.documentElement;
    root.dataset.cazamiVersion='pc2-20261123';
    root.dataset.cazamiMode=mode;
    if(useDesktop){
      root.classList.add('cazami-desktop-fit');
      var meta=document.querySelector('meta[name="viewport"]');
      if(meta)meta.setAttribute('content','width=1080, viewport-fit=cover');
    }
    if(forced){try{localStorage.setItem(key,forced);}catch(e){}}
    root.dataset.cazamiSwitcher=(handheld||saved||forced)?'true':'false';
  })();
</script>}<meta name="theme-color" content="#261f22"/><meta name="description" content={description}/>
<meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/>
{og && <meta property="og:image" content={og}/>}{canonical && <><meta property="og:url" content={canonical}/><link rel="canonical" href={canonical}/></>}
<link rel="icon" type="image/png" href="/favicon.png"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&display=swap" rel="stylesheet"/><title>{title}</title></head>
<body class={Astro.url.pathname === '/' ? 'cazami-home' : 'cazami-inner'}>
<div id="reading-progress" class="reading-progress" aria-hidden="true"></div>
<div class="topline"><div class="wrap"><span>CAZAMI STUDIO · CATÁLOGO DE TRABAJOS</span><span>INVITACIONES Y PASES</span></div></div>
<header class="header" id="header"><div class="wrap header__inner">
<a class="brand" href="/" aria-label="CAZAMI Studio, ir al inicio"><img src="/brand/cz-blanco.png" alt="" width="38" height="38"/><span>CAZAMI <small>STUDIO</small></span></a>
<nav class="navigation" id="navigation" aria-label="Navegación principal"><a href="/#coleccion">Invitaciones</a><a href="/#pases">Pases</a><a href="/#cotizacion">Cotizar</a><a class="navigation__admin" href="/admin/" rel="nofollow"><UiIcon name="lock" size={16}/> Administrar catálogo</a></nav>
<a class="header__admin" href="/admin/" rel="nofollow" aria-label="Abrir administrador de invitaciones y pases"><UiIcon name="lock" size={16}/><span>Admin</span></a><a class="header__quote" href={contactHref()} target="_blank" rel="noopener noreferrer">Hablemos <UiIcon name="external" size={14}/></a><button id="menu-toggle" type="button" class="menu-toggle" aria-controls="navigation" aria-expanded="false" aria-label="Abrir menú"><span></span><span></span></button>
</div></header><main><slot/></main>
{Astro.url.pathname === '/' && <nav class="mobile-dock" aria-label="Menú rápido del catálogo"><a href="#inicio"><UiIcon name="sparkles" size={19}/><span>Inicio</span></a><a href="#novedades"><UiIcon name="image" size={19}/><span>Nuevos</span></a><a href="#coleccion"><UiIcon name="grid" size={19}/><span>Catálogo</span></a><a class="mobile-dock__cta" href={contactHref('Hola, CAZAMI. Quiero cotizar una invitación digital.')} target="_blank" rel="noopener noreferrer"><UiIcon name="arrow" size={19}/><span>Cotizar</span></a></nav>}
{Astro.url.pathname === '/' && <button type="button" id="catalog-view-toggle" class="catalog-view-toggle" hidden aria-label="Cambiar vista del catálogo"><UiIcon name="grid" size={19}/><span>Vista PC</span></button>}
<footer class="footer"><div class="wrap"><div class="footer__top"><div><a href="/" class="footer__brand">CAZAMI<span>®</span></a><p>Diseño digital para momentos que merecen ser recordados.</p></div><a href="#" class="footer__up">Volver arriba <UiIcon name="arrow-up" size={15}/></a></div><div class="footer__line"></div><div class="footer__bottom"><span>© {new Date().getFullYear()} CAZAMI STUDIO</span><div><a href={contactHref()} target="_blank" rel="noopener noreferrer">WhatsApp <UiIcon name="external" size={13}/></a><a href={site.tiktok} target="_blank" rel="noopener noreferrer">TikTok <UiIcon name="external" size={13}/></a><a href={site.facebook} target="_blank" rel="noopener noreferrer">Facebook <UiIcon name="external" size={13}/></a><a href="/admin/" rel="nofollow">Admin</a></div></div></div></footer>
<script>
 const header=document.getElementById('header');const toggle=document.getElementById('menu-toggle');const menu=document.getElementById('navigation');
 const closeMenu=()=>{toggle?.setAttribute('aria-expanded','false');menu?.classList.remove('navigation--open');document.body.classList.remove('menu-open');};
 toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')==='true';toggle.setAttribute('aria-expanded',String(!open));menu?.classList.toggle('navigation--open',!open);document.body.classList.toggle('menu-open',!open);});
 menu?.querySelectorAll('a').forEach(a=>a.addEventListener('click',closeMenu));document.addEventListener('keydown',e=>{if(e.key==='Escape')closeMenu();});
 const viewToggle=document.getElementById('catalog-view-toggle');
 if(viewToggle && document.documentElement.dataset.cazamiSwitcher==='true'){
   const isDesktop=document.documentElement.classList.contains('cazami-desktop-fit');
   const label=viewToggle.querySelector('span');
   viewToggle.hidden=false;
   if(label)label.textContent=isDesktop?'Vista móvil':'Vista PC';
   viewToggle.setAttribute('aria-label',isDesktop?'Mostrar la versión móvil con textos más grandes':'Mostrar la versión de computadora escalada');
   viewToggle.setAttribute('aria-pressed',String(isDesktop));
   viewToggle.addEventListener('click',()=>{
     try{localStorage.setItem('cazami-catalogo-vista-v2',isDesktop?'movil':'pc');}catch(error){}
     // Eliminar ?vista=... para que la selección del botón tenga prioridad.
     if(new URLSearchParams(window.location.search).has('vista')){
       const next=new URL(window.location.href);next.searchParams.delete('vista');
       window.history.replaceState(null,'',next.pathname+next.search+next.hash);
     }
     window.location.reload();
   });
 }
 const bar=document.getElementById('reading-progress');const updateScroll=()=>{header?.classList.toggle('header--scrolled',window.scrollY>15);if(bar){const max=document.documentElement.scrollHeight-window.innerHeight;bar.style.transform=`scaleX(${max>0?window.scrollY/max:0})`;}};
 window.addEventListener('scroll',updateScroll,{passive:true});updateScroll();
 if('IntersectionObserver' in window){const observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');observer.unobserve(e.target);}}),{threshold:.08,rootMargin:'0px 0px -24px 0px'});document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));}else document.querySelectorAll('.reveal').forEach(el=>el.classList.add('visible'));
</script></body></html>

---
import '../styles/global.css';
import {site,contactHref} from '../data/site';
import Icon from '../components/Icon.astro';
interface Props {title?:string;description?:string;image?:string}
const {title=site.title,description=site.description,image='/og-cover.png'}=Astro.props;
const origin=import.meta.env.PUBLIC_SITE_URL||Astro.site?.toString();
const canonical=origin?new URL(Astro.url.pathname,origin).toString():undefined;
const og=origin?new URL(image,origin).toString():undefined;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
<meta name="theme-color" content="#1c2622"/><meta name="color-scheme" content="light"/><meta name="description" content={description}/>
<meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/>
{og&&<meta property="og:image" content={og}/>}{canonical&&<><meta property="og:url" content={canonical}/><link rel="canonical" href={canonical}/></>}
<link rel="icon" href="/favicon.png" type="image/png"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&display=swap" rel="stylesheet"/>
<title>{title}</title>
</head>
<body>
<div class="intro" id="intro" aria-label="CAZAMI Studio"><div class="intro__mark"><img src="/brand/cz-blanco.png" width="128" height="128" alt=""/><span>CAZAMI</span><small>STUDIO DE INVITACIONES</small></div><div class="intro__progress"><span></span></div></div>
<a class="skip-link" href="#contenido">Saltar al contenido</a>
<div class="reading-progress" id="reading-progress" aria-hidden="true"></div>
<header class="site-header" id="site-header"><div class="shell site-header__inside">
<a class="site-brand" href="/#inicio" aria-label="CAZAMI Studio, inicio"><img src="/brand/cz-blanco.png" width="43" height="43" alt=""/><span>CAZAMI <small>STUDIO</small></span></a>
<nav class="site-nav" id="site-nav" aria-label="Navegación principal"><a href="/#concepto">Nosotros</a><a href="/#invitaciones">Invitaciones</a><a href="/#coleccion">Portafolio</a><a href="/#pases">Pases</a><a href="/#nfc">NFC</a><a href="/#proceso">Proceso</a><a class="site-nav__mobile" href={contactHref('Hola, CAZAMI. Quiero cotizar una invitación personalizada.')} target="_blank" rel="noopener noreferrer">Solicitar cotización <Icon name="arrowUp" size={18}/></a></nav>
<a class="site-header__cta" href={contactHref('Hola, CAZAMI. Quiero una cotización personalizada.')} target="_blank" rel="noopener noreferrer">Hablemos <Icon name="arrowUp" size={17}/></a>
<button class="menu-button" id="menu-button" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="Abrir menú"><Icon name="menu" size={23}/></button>
</div></header>
<main id="contenido"><slot/></main>
<footer class="site-footer"><div class="shell"><div class="site-footer__top"><div class="site-footer__brand">CAZAMI <span>STUDIO</span></div><a class="footer-top" href="#inicio">Volver al inicio <Icon name="arrowUp" size={16}/></a></div><div class="site-footer__bottom"><p>Diseñamos primeras impresiones que permanecen.</p><div><a href={contactHref()} target="_blank" rel="noopener noreferrer">WhatsApp</a><a href={site.tiktok} target="_blank" rel="noopener noreferrer">TikTok</a><a href={site.facebook} target="_blank" rel="noopener noreferrer">Facebook</a></div><small>© {new Date().getFullYear()} CAZAMI STUDIO</small></div></div></footer>
<script>
 // Mantener los controles disponibles aunque Safari bloquee storage o alguna animación.
 const intro = document.getElementById('intro');
 const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
 let introSeen = false;
 try { introSeen = window.sessionStorage.getItem('cazami-intro-seen') === '1'; } catch { introSeen = false; }
 const dismissIntro = () => {
   if (!intro || intro.classList.contains('intro--done')) return;
   intro.classList.add('intro--done');
   window.setTimeout(() => intro.remove(), 520);
 };
 if (prefersReducedMotion.matches || introSeen) dismissIntro();
 else {
   try { window.sessionStorage.setItem('cazami-intro-seen', '1'); } catch { /* almacenamiento restringido */ }
   window.setTimeout(dismissIntro, 1150);
 }
 // Alternativa de seguridad si una pestaña se reanuda desde la caché de Safari.
 window.addEventListener('pageshow', (event) => { if (event.persisted) dismissIntro(); });
 const menuButton = document.getElementById('menu-button') as HTMLButtonElement | null;
 const menu = document.getElementById('site-nav');
 let savedScroll = 0;
 let menuOpen = false;
 const closeMenu = () => {
   if (!menuOpen) return;
   menuOpen = false;
   menuButton?.setAttribute('aria-expanded', 'false');
   menuButton?.setAttribute('aria-label', 'Abrir menú');
   menu?.classList.remove('site-nav--open');
   document.body.classList.remove('menu-open');
   document.body.style.top = '';
   window.scrollTo(0, savedScroll);
 };
 const openMenu = () => {
   if (menuOpen) return;
   savedScroll = Math.max(0, window.scrollY || window.pageYOffset || 0);
   menuOpen = true;
   menuButton?.setAttribute('aria-expanded', 'true');
   menuButton?.setAttribute('aria-label', 'Cerrar menú');
   menu?.classList.add('site-nav--open');
   document.body.style.top = `-${savedScroll}px`;
   document.body.classList.add('menu-open');
 };
 menuButton?.addEventListener('click', () => menuOpen ? closeMenu() : openMenu());
 menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
 document.addEventListener('keydown', event => { if (event.key === 'Escape') closeMenu(); });
 window.addEventListener('resize', () => { if (menuOpen && window.innerWidth >= 940) closeMenu(); }, {passive:true});
 const progress = document.getElementById('reading-progress');
 let ticking = false;
 const paintProgress = () => {
   const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
   if (progress) progress.style.transform = `scaleX(${Math.min(1, Math.max(0, window.scrollY / max))})`;
   ticking = false;
 };
 window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(paintProgress); } }, {passive:true});
 paintProgress();
 const revealItems = document.querySelectorAll('.rise');
 if ('IntersectionObserver' in window && !prefersReducedMotion.matches) {
   const observer = new IntersectionObserver((entries) => {
     for (const entry of entries) {
       if (entry.isIntersecting) { entry.target.classList.add('in-view'); observer.unobserve(entry.target); }
     }
   }, { threshold: 0.025, rootMargin: '0px 0px 40px 0px' });
   revealItems.forEach(el => observer.observe(el));
 } else revealItems.forEach(el => el.classList.add('in-view'));
</script>
</body>
</html>

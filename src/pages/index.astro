---
import BaseLayout from '../layouts/BaseLayout.astro';
import InvitationCard from '../components/InvitationCard.astro';
import PassGallery from '../components/PassGallery.astro';
import NfcShowcase from '../components/NfcShowcase.astro';
import {catalog,categories} from '../data/catalog';
import {site,contactHref} from '../data/site';
const featureItems=[
  {number:'01',title:'Música',description:'Una canción que acompañe el recorrido por la invitación.'},
  {number:'02',title:'Galería fotográfica',description:'Una selección de recuerdos para compartir con los invitados.'},
  {number:'03',title:'Ubicación',description:'Información y enlaces de los lugares de la celebración.'},
  {number:'04',title:'Confirmación',description:'Una forma práctica de recibir respuestas de asistencia.'},
  {number:'05',title:'Libro de firmas',description:'Un espacio digital para mensajes y buenos deseos.'},
  {number:'06',title:'Pases personalizados',description:'Datos de cada invitado y sus accesos autorizados, cuando se contraten.'},
];
---
<BaseLayout>
<section class="hero" id="inicio" aria-labelledby="hero-title"><div class="wrap hero-grid"><div class="hero-copy"><p class="hero-kicker"><span class="eyebrow-line"></span> EL ESTUDIO DE LAS PRIMERAS IMPRESIONES</p><h1 class="hero-title" id="hero-title">Hay momentos que merecen <em>algo extraordinario.</em></h1><p class="hero-lead">Invitaciones digitales de autor, pases personalizados y experiencias pensadas para dar la bienvenida a quienes más importan.</p><div class="hero-links"><a href="#servicios" class="button button--cream">Descubre CAZAMI <span aria-hidden="true">↗</span></a><a href="#coleccion" class="text-arrow text-arrow--light">Ver trabajos reales ↗</a></div><div class="hero-baseline"><span>CAZAMI STUDIO</span><span>DISEÑO · DETALLE · EXPERIENCIA</span></div></div><div class="hero-visual"><div class="hero-visual__frame"><div class="hero-visual__phone"><img src="/previews-real/zyc-invitacion.png" width="451" height="661" alt="Captura auténtica de la portada web de la boda de Zaid y Camila" fetchpriority="high" /></div><div class="hero-visual__floating"><span>SELECCIÓN DEL ESTUDIO</span><b>Zaid <i>&</i> Camila</b><small>Una invitación web real</small></div></div><div class="hero-visual__side">PORTADA AUTÉNTICA · NO ES UN PASE DIGITAL</div></div></div><a class="hero-scroll" href="#servicios">DESLIZA PARA EXPLORAR <span aria-hidden="true">↓</span></a></section>
<section class="manifesto section-space" id="servicios"><div class="wrap"><div class="section-bar"><span>01 — LA ESENCIA CAZAMI</span><span>UNA EXPERIENCIA MÁS ALLÁ DEL MENSAJE</span></div><div class="manifesto-grid"><h2 class="display-title reveal">La forma de invitar también <em>cuenta tu historia.</em></h2><div class="manifesto-copy reveal"><p class="lead">Creamos experiencias digitales personalizadas para bodas, XV años, cumpleaños y celebraciones especiales.</p><p>Una invitación puede ser el principio de la emoción, un pase puede facilitar la bienvenida y una recepción organizada puede hacer más agradable la llegada.</p><a href={contactHref()} class="text-arrow" target="_blank" rel="noopener noreferrer">Cuéntanos tu evento ↗</a></div></div><div class="service-index"><a href="#invitaciones-web"><span>01</span><b>Invitaciones web</b><small>Diseño e interacción</small><span aria-hidden="true">↗</span></a><a href="#pases"><span>02</span><b>Pases digitales</b><small>Identidad para cada acceso</small><span aria-hidden="true">↗</span></a><a href="#control"><span>03</span><b>Acceso y recepción</b><small>Organización de invitados</small><span aria-hidden="true">↗</span></a><a href="#nfc"><span>04</span><b>Tarjetas NFC</b><small>Una entrega tangible</small><span aria-hidden="true">↗</span></a></div></div></section>
<section class="web-story section-space" id="invitaciones-web"><div class="wrap web-story-grid"><div class="web-story-photo reveal"><div class="web-story-photo__back"></div><div class="web-story-photo__screen"><img src="/previews-real/zyc-invitacion.png" alt="Portada original de la invitación web Zaid y Camila" loading="lazy" width="451" height="661"/></div><div class="web-story-photo__caption"><span>CASO DE ESTUDIO / 001</span><strong>Zaid & Camila</strong><span>INVITACIÓN WEB PUBLICADA</span></div></div><div class="web-story-copy reveal"><span class="eyebrow">02 / INVITACIONES WEB PERSONALIZADAS</span><h2 class="display-title">No es una plantilla. <em>Es tu celebración, convertida en web.</em></h2><p class="lead">Una página creada alrededor de la identidad de tu evento, diseñada para abrirse en el celular y compartirse fácilmente.</p><div class="editorial-answers"><div><span>QUÉ ES</span><p>Un sitio de invitación digital personalizado con la presentación de tu celebración.</p></div><div><span>CÓMO FUNCIONA</span><p>Compartes el enlace; tus invitados abren la experiencia desde su navegador.</p></div><div><span>QUÉ APORTA</span><p>Una primera impresión cuidada y un espacio para la información del gran día.</p></div></div><a href={site.exampleUrl} target="_blank" rel="noopener noreferrer" class="button button--ink">Explorar la invitación real <span aria-hidden="true">↗</span></a></div></div></section>
<section class="features-section section-space" id="funciones"><div class="wrap"><div class="section-bar"><span>03 — POSIBILIDADES DE TU INVITACIÓN</span><span>CONTENIDO SEGÚN COTIZACIÓN</span></div><div class="features-head"><h2 class="display-title reveal">Cada función tiene <em>un propósito.</em></h2><div class="features-head__aside reveal"><p>La experiencia puede incorporar diferentes elementos interactivos. Elegimos contigo lo que realmente necesita tu celebración.</p><strong>Estas funciones no están incluidas automáticamente en todos los proyectos.</strong></div></div><div class="feature-list">{featureItems.map(feature=><article class="feature-item reveal"><span>{feature.number}</span><h3>{feature.title}</h3><p>{feature.description}</p><span class="feature-item__symbol" aria-hidden="true">✳</span></article>)}</div><a class="text-arrow" href={contactHref('Hola, CAZAMI. Quiero conocer las funcionalidades disponibles para una invitación web personalizada.')} target="_blank" rel="noopener noreferrer">Elegir funcionalidades para mi evento ↗</a></div></section>
<section class="portfolio section-space" id="coleccion"><div class="wrap"><div class="section-bar"><span>04 — PORTAFOLIO WEB</span><span>14 INVITACIONES / DEMOSTRACIONES ORIGINALES</span></div><div class="portfolio-heading"><div><h2 class="display-title reveal">Historias que ya <em>tomaron forma.</em></h2><p>Explora nuestros proyectos reales. Las vistas están bloqueadas para evitar interacciones accidentales; el botón «Abrir demo» te lleva a cada sitio original.</p></div><span class="portfolio-heading__badge">PORTAFOLIO<br/><b>14</b> OBRAS</span></div><div class="portfolio-controls"><div class="filterbar" aria-label="Filtrar portafolio">{categories.map((cat,index)=><button type="button" class:list={['filterbtn',{'filterbtn--active':index===0}]} data-filter={cat} aria-pressed={index===0}>{cat}</button>)}</div><label class="portfolio-search"><span aria-hidden="true">⌕</span><input id="work-search" type="search" placeholder="Buscar por nombre o evento" aria-label="Buscar proyectos" autocomplete="off" /></label></div><p class="portfolio-count" id="portfolio-count">MOSTRANDO 14 PROYECTOS</p><div class="works-grid" id="works-grid">{catalog.map((item,index)=><InvitationCard item={item} index={index}/>)}</div><p class="portfolio-empty" id="portfolio-empty" hidden>No encontramos proyectos con ese filtro. Prueba con otra categoría o nombre.</p><div class="portfolio-disclaimer"><span aria-hidden="true">ⓘ</span><p>Solo Zaid & Camila cuenta con una captura de portada auténtica proporcionada por el estudio. Los otros proyectos se muestran mediante sus webs originales cuando permiten su integración. Si una vista no carga, utiliza «Abrir demo». <strong>Las imágenes de los pases no se utilizan aquí como portadas.</strong></p></div></div></section>
<PassGallery />
<section class="qr-section section-space" id="control"><div class="wrap"><div class="section-bar section-bar--inverse"><span>06 — CÓDIGOS QR Y ACCESO</span><span>ORGANIZACIÓN DESDE EL PASE</span></div><div class="qr-head"><div class="reveal"><h2 class="display-title">Un acceso claro.<br/><em>Una bienvenida mejor.</em></h2><p class="lead">Los pases con códigos QR ayudan a identificar a los invitados y consultar la información asociada a su acceso durante la recepción.</p></div><div class="qr-head__end"><span>CONTROL DE ACCESO</span><p>Servicio a cotizar según el número de invitados y las necesidades del evento.</p></div></div><div class="qr-flow"><article class="qr-flow__step"><span>01 / PREPARACIÓN</span><div class="qr-flow__icon">◎</div><h3>Pases con datos</h3><p>Se preparan los pases digitales para los invitados con la información correspondiente.</p></article><span class="qr-flow__arrow" aria-hidden="true">↗</span><article class="qr-flow__step"><span>02 / LLEGADA</span><div class="qr-flow__icon">▦</div><h3>Presentación de QR</h3><p>El invitado muestra su pase al personal responsable de la recepción.</p></article><span class="qr-flow__arrow" aria-hidden="true">↗</span><article class="qr-flow__step"><span>03 / REVISIÓN</span><div class="qr-flow__icon">✓</div><h3>Consulta de acceso</h3><p>Se comprueba la información del pase de acuerdo con la organización del evento.</p></article></div><div class="qr-bottom"><p><b>¿Qué beneficio ofrece?</b> Un apoyo para ordenar el ingreso y reducir confusiones al momento de recibir a los invitados.</p><a href={contactHref('Hola, CAZAMI. Quiero cotizar pases con códigos QR y control de acceso.')} target="_blank" rel="noopener noreferrer" class="text-arrow text-arrow--light">Consultar control de acceso ↗</a></div></div></section>
<section class="reception-section section-space" id="recepcion"><div class="wrap reception-layout"><div class="reception-title reveal"><span class="eyebrow">07 / RECEPCIÓN Y MESAS</span><h2 class="display-title">Tu evento comienza <em>con una bienvenida.</em></h2><p class="lead">La recepción de invitados y la asignación de mesas pueden organizarse como parte del servicio para eventos que requieran una distribución de asistentes.</p><a href={contactHref('Hola, CAZAMI. Me interesa cotizar la organización de recepción y asignación de mesas.')} target="_blank" rel="noopener noreferrer" class="button button--ink">Solicitar información ↗</a></div><div class="reception-board reveal"><div class="reception-board__header"><span>ORGANIZACIÓN DE INVITADOS</span><span>VISTA EXPLICATIVA · SIN DATOS REALES</span></div><div class="reception-board__intro"><h3>Una recepción <em>ordenada</em></h3><p>Concepto de trabajo para organizar mesas e invitados.</p></div><div class="reception-board__rows"><div><span>01</span><b>Lista de invitados</b><small>Identificación para recibir a cada persona</small></div><div><span>02</span><b>Asignación por mesa</b><small>Distribución definida para la celebración</small></div><div><span>03</span><b>Apoyo en recepción</b><small>Consulta de la ubicación correspondiente</small></div></div><div class="reception-board__foot"><span>NO ES UNA CAPTURA DE SOFTWARE</span><span>CAZAMI STUDIO ©</span></div></div></div></section>
<NfcShowcase />
<section class="quotation-section section-space" id="cotizacion"><div class="wrap"><div class="section-bar"><span>09 — CONTRATACIÓN A MEDIDA</span><span>PRECIOS SOLO MEDIANTE COTIZACIÓN</span></div><div class="quotation-top"><div><h2 class="display-title">Lo que necesitas.<br/><em>Ni más ni menos.</em></h2></div><p class="lead">Cada evento es distinto. Por eso preparamos una propuesta según el diseño, las funcionalidades y los servicios solicitados. No publicamos precios ni paquetes cerrados sin confirmación.</p></div><div class="quotation-grid"><article class="quote-card"><span>ÁREA 01</span><h3>Invitación web</h3><p>Diseño digital personalizado para presentar tu celebración y su información.</p><b>Cotización personalizada</b><a href={contactHref('Hola, CAZAMI. Quiero cotizar una invitación web personalizada.')} target="_blank" rel="noopener noreferrer">Pedir cotización ↗</a></article><article class="quote-card quote-card--accent"><span>ÁREA 02</span><h3>Pases y acceso</h3><p>Pases digitales personalizados y consulta de opciones con QR para organizar el acceso.</p><b>Cotización personalizada</b><a href={contactHref('Hola, CAZAMI. Quiero cotizar pases digitales y control de acceso.')} target="_blank" rel="noopener noreferrer">Pedir cotización ↗</a></article><article class="quote-card"><span>ÁREA 03</span><h3>Servicios complementarios</h3><p>Tarjetas NFC, recepción de invitados y asignación de mesas, de acuerdo con el alcance solicitado.</p><b>Cotización personalizada</b><a href={contactHref('Hola, CAZAMI. Quiero consultar servicios adicionales de tarjetas NFC, recepción y mesas.')} target="_blank" rel="noopener noreferrer">Pedir cotización ↗</a></article></div><p class="quotation-foot">Estas son áreas de servicio para orientarte, <strong>no paquetes con contenido o precio preestablecido.</strong> Disponibilidad y alcance sujetos a confirmación antes de contratar.</p></div></section>
<section class="process-section section-space" id="proceso"><div class="wrap"><div class="section-bar"><span>10 — ASÍ TRABAJAMOS</span><span>DEL PRIMER MENSAJE AL RESULTADO FINAL</span></div><div class="process-heading"><h2 class="display-title">Un proceso simple.<br/><em>Un resultado personal.</em></h2><p>La claridad también forma parte de una buena experiencia. Así comienza el diseño de tu celebración con CAZAMI.</p></div><div class="process-timeline"><article><span>01</span><h3>Nos cuentas tu idea</h3><p>Qué tipo de evento estás organizando, fecha, estilo y necesidades.</p></article><article><span>02</span><h3>Definimos el alcance</h3><p>Te explicamos las opciones disponibles y preparamos tu cotización.</p></article><article><span>03</span><h3>Diseñamos contigo</h3><p>Trabajamos la identidad visual y los datos del proyecto acordado.</p></article><article><span>04</span><h3>Compartes la experiencia</h3><p>Una vez aprobado y entregado el proyecto, podrás compartir tu invitación o pases.</p></article></div></div></section>
<section class="final-cta section-space" id="contacto"><div class="wrap final-cta-grid"><div><span class="eyebrow">11 / EMPECEMOS A CREAR</span><h2 class="display-title">Toda gran historia <em>merece una gran entrada.</em></h2><p>Cuéntanos qué vas a celebrar. Nos encantará conocer tu idea y preparar una propuesta para tu evento.</p><div class="final-cta__actions"><a href={contactHref('Hola, CAZAMI. Vi su catálogo y me gustaría solicitar una cotización personalizada para mi evento.')} target="_blank" rel="noopener noreferrer" class="button button--cream">Solicitar cotización por WhatsApp ↗</a><a class="text-arrow text-arrow--light" href={site.tiktok} target="_blank" rel="noopener noreferrer">Conocer nuestro TikTok ↗</a></div></div><div class="final-cta__brand"><img src="/brand/cz-blanco.png" alt="Monograma oficial CAZAMI" width="160" height="160"/><span>INVITACIONES DE AUTOR</span><strong>CAZAMI</strong><small>ESTUDIO DIGITAL PARA CELEBRACIONES</small><div class="final-cta__line"></div><p>{site.whatsappDisplay}</p></div></div></section>
<script>
 const cards=Array.from(document.querySelectorAll<HTMLElement>('[data-work-card]'));
 const filterButtons=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
 const search=document.getElementById('work-search') as HTMLInputElement|null;
 const count=document.getElementById('portfolio-count');
 const empty=document.getElementById('portfolio-empty');
 let category='Todas';
 const redraw=()=>{const q=(search?.value||'').trim().toLocaleLowerCase('es-MX');let n=0;cards.forEach(card=>{const shown=(category==='Todas'||card.dataset.category===category)&&(card.dataset.search||'').includes(q);card.hidden=!shown;if(shown)n++;});if(count)count.textContent=`MOSTRANDO ${n} ${n===1?'PROYECTO':'PROYECTOS'}`;if(empty)empty.hidden=n>0;};
 filterButtons.forEach(button=>button.addEventListener('click',()=>{category=button.dataset.filter||'Todas';filterButtons.forEach(b=>{const active=b===button;b.classList.toggle('filterbtn--active',active);b.setAttribute('aria-pressed',String(active));});redraw();}));
 search?.addEventListener('input',redraw);redraw();
 // Solo sitios de invitaciones, nunca fotografías de pases.
 const previews=Array.from(document.querySelectorAll<HTMLElement>('[data-web-preview]'));
 const activate=(host:HTMLElement)=>{const iframe=host.querySelector<HTMLIFrameElement>('iframe[data-src]');if(!iframe||iframe.src)return;const fit=()=>{const w=host.getBoundingClientRect().width;iframe.style.transform=`scale(${w/390})`;};fit();iframe.src=iframe.dataset.src||'';};
 if('ResizeObserver' in window){const ro=new ResizeObserver(entries=>entries.forEach(entry=>{const frame=entry.target.querySelector<HTMLIFrameElement>('iframe[data-src]');if(frame)frame.style.transform=`scale(${entry.contentRect.width/390})`;}));previews.forEach(host=>ro.observe(host));}
 if('IntersectionObserver' in window){const observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){activate(e.target as HTMLElement);observer.unobserve(e.target);}}),{rootMargin:'180px 0px'});previews.forEach(host=>observer.observe(host));}else previews.forEach(activate);
</script>
</BaseLayout>

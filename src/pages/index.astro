---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import InvitationCard from '../components/InvitationCard.astro';
import PassGallery from '../components/PassGallery.astro';
import NfcShowcase from '../components/NfcShowcase.astro';
import {catalog,categories} from '../data/catalog';
import {site,contactHref} from '../data/site';
const features=[
 {icon:'music',title:'Música',description:'Una melodía para acompañar la experiencia.'},
 {icon:'gallery',title:'Galería fotográfica',description:'Imágenes y recuerdos en un solo lugar.'},
 {icon:'map',title:'Ubicaciones',description:'Accesos rápidos a los lugares de la celebración.'},
 {icon:'check',title:'Confirmación',description:'Una forma práctica de responder a la invitación.'},
 {icon:'pen',title:'Libro de firmas',description:'Mensajes y buenos deseos de tus invitados.'},
 {icon:'ticket',title:'Pases personalizados',description:'Datos de invitados y lugares autorizados.'}
] as const;
const serviceCards=[
 {index:'01',icon:'smartphone',title:'Invitaciones web',text:'Una experiencia diseñada para anunciar tu evento con personalidad.',anchor:'#invitaciones'},
 {index:'02',icon:'ticket',title:'Pases digitales',text:'Piezas personalizadas para compartir información de acceso.',anchor:'#pases'},
 {index:'03',icon:'qr',title:'Control con QR',text:'Identificación y consulta de pases al recibir invitados.',anchor:'#control'},
 {index:'04',icon:'users',title:'Recepción y mesas',text:'Apoyo para organizar la llegada y ubicación de los asistentes.',anchor:'#recepcion'},
 {index:'05',icon:'radio',title:'Tarjetas NFC',text:'Un detalle semifísico que conecta con tu invitación web.',anchor:'#nfc'}
] as const;
---
<BaseLayout>
<section class="hero" id="inicio"><div class="hero__grain" aria-hidden="true"></div><div class="shell hero__layout">
 <div class="hero__copy"><p class="hero__eyebrow rise"><span class="hero__eyebrow-rule"></span> CAZAMI STUDIO <span class="hero__eyebrow-sep">/</span> INVITACIONES DE AUTOR</p><h1 class="hero__title rise">El arte de <em>invitar</em><span class="hero__period">.</span></h1><p class="hero__lead rise">Hay momentos que merecen más que una invitación. Creamos experiencias digitales que cuentan tu historia desde el primer instante.</p><div class="hero__buttons rise"><a class="btn btn--light" href="#coleccion">Explorar proyectos <Icon name="arrowUp" size={19}/></a><a class="text-link text-link--light" href="#servicios">Descubrir servicios <Icon name="arrow" size={20}/></a></div><div class="hero__bottom rise"><span>DISEÑADO CON INTENCIÓN</span><span class="hero__bottom-line"></span><span>DESLIZA PARA DESCUBRIR</span></div></div>
 <div class="hero__visual rise"><span class="hero__visual-top">01 <span>/</span> PROYECTO DESTACADO</span><div class="hero__device"><div class="hero__device-cap"><span></span><span>CAZAMI / INVITACIÓN WEB</span><span><Icon name="arrowUp" size={15}/></span></div><a href="https://zyc-invitacion.netlify.app/" target="_blank" rel="noopener noreferrer" aria-label="Abrir invitación original de Zaid y Camila"><img src="/previews-real/zyc-invitacion.png" alt="Captura auténtica de la portada web de Zaid y Camila" width="451" height="661" fetchpriority="high"/><div class="hero__device-overlay"><span>ABRIR INVITACIÓN ORIGINAL</span><Icon name="arrowUp" size={19}/></div></a></div><div class="hero__visual-caption"><div><strong>Zaid & Camila</strong><small>BODA · INVITACIÓN WEB REAL</small></div><span>01 — 14</span></div></div>
 </div><div class="hero__corner" aria-hidden="true">CAZAMI — EST. 2025</div></section>
<section class="manifesto section" id="concepto"><div class="shell"><div class="section-meta"><span>00 / NUESTRO ESTUDIO</span><span>EL PRIMER CAPÍTULO DE TU EVENTO</span></div><div class="manifesto__grid"><div class="rise"><p class="kicker">Un diseño que se siente propio</p><h2 class="display">Tu celebración tiene una historia. <em>Nosotros le damos forma.</em></h2></div><div class="manifesto__aside rise"><p>No trabajamos con una sola apariencia para todas las ocasiones. Escuchamos tu idea y diseñamos una presentación digital que refleje la personalidad de tu evento.</p><div class="manifesto__signature"><img src="/brand/cz-negro.png" alt="Monograma CZ de CAZAMI" loading="lazy" width="70" height="70"/><span>CAZAMI STUDIO<small>DETALLES QUE PERMANECEN</small></span></div></div></div></div></section>
<section class="services section" id="servicios"><div class="shell"><div class="section-meta"><span>01 / NUESTROS SERVICIOS</span><span>DESCUBRE LO QUE PODEMOS CREAR</span></div><div class="section-intro rise"><div><p class="kicker">Todo comienza con una idea</p><h2 class="display">Una experiencia completa, <em>por partes bien pensadas.</em></h2></div><p>Explora cada servicio por separado. Podemos revisar contigo qué necesitas y preparar una propuesta personalizada.</p></div><div class="service-list">{serviceCards.map(service=><a class="service-row rise" href={service.anchor}><span class="service-row__index">{service.index}</span><span class="service-row__icon"><Icon name={service.icon} size={27}/></span><span class="service-row__body"><strong>{service.title}</strong><small>{service.text}</small></span><span class="service-row__arrow"><Icon name="arrowUp" size={21}/></span></a>)}</div></div></section>
<section class="web-section section" id="invitaciones"><div class="shell"><div class="section-meta"><span>02 / INVITACIONES WEB</span><span>MUCHO MÁS QUE UN MENSAJE</span></div><div class="web-section__grid"><div class="web-section__story rise"><p class="kicker">Una página hecha para tu historia</p><h2 class="display">Una invitación que <em>se descubre.</em></h2><p class="body-lead">Diseñamos páginas web personalizadas que reúnen la información y los detalles de tu evento en una experiencia visual pensada para compartirse fácilmente.</p><div class="web-section__quote">“La primera impresión de un gran día también puede ser inolvidable.”</div><a class="btn btn--ink" href={contactHref('Hola, CAZAMI. Quiero cotizar una invitación web personalizada.')} target="_blank" rel="noopener noreferrer">Cotizar invitación web <Icon name="arrowUp" size={18}/></a></div><div class="web-section__detail rise"><div class="web-section__top"><Icon name="smartphone" size={23}/><span>COMPONENTES DISPONIBLES SEGÚN COTIZACIÓN</span></div><div class="feature-grid">{features.map((item,index)=><div class="feature"><div class="feature__icon"><Icon name={item.icon} size={23}/></div><div><span>{String(index+1).padStart(2,'0')}</span><h3>{item.title}</h3><p>{item.description}</p></div></div>)}</div><p class="web-section__disclaimer"><Icon name="shield" size={17}/> Las funcionalidades de cada proyecto se acuerdan al cotizar; no todas están incluidas automáticamente.</p></div></div></div></section>
<section class="portfolio section" id="coleccion"><div class="shell"><div class="section-meta"><span>03 / PORTAFOLIO</span><span>14 PROYECTOS CON DEMO ORIGINAL</span></div><div class="portfolio__heading"><div class="rise"><p class="kicker">Proyectos reales del estudio</p><h2 class="display">Historias distintas. <em>Diseños únicos.</em></h2></div><p class="rise">Explora las invitaciones web que hemos creado. Las demostraciones se abren en su sitio original para vivir la experiencia completa.</p></div><div class="portfolio__tools"><div class="filter-list" role="group" aria-label="Filtrar portafolio">{categories.map((cat,index)=><button type="button" class:list={['filter-pill',index===0&&'filter-pill--active']} data-filter={cat} aria-pressed={index===0?'true':'false'}>{cat}</button>)}</div><label class="portfolio-search"><Icon name="gallery" size={18}/><span class="sr-only">Buscar invitaciones</span><input id="portfolio-search" type="search" placeholder="Buscar proyecto" autocomplete="off"/></label></div><div class="portfolio__status" id="portfolio-status">14 PROYECTOS</div><div class="portfolio-grid">{catalog.map((item,index)=><InvitationCard item={item} index={index}/>)}</div><div class="portfolio-empty" id="portfolio-empty" hidden>No encontramos proyectos con ese filtro. Prueba otra categoría.</div><p class="portfolio__note"><Icon name="shield" size={18}/> Solo Zaid & Camila cuenta por ahora con una captura auténtica de su portada web. Las demás tarjetas muestran fichas editoriales identificadas y enlazan a sus demos originales; los pases digitales no se usan como portadas.</p></div></section>
<PassGallery/>
<section class="access-section section" id="control"><div class="shell"><div class="section-meta"><span>06 / CÓDIGOS QR Y CONTROL DE ACCESO</span><span>LA ORGANIZACIÓN TAMBIÉN ES UN DETALLE</span></div><div class="access-section__grid"><div class="rise"><p class="kicker">Información clara al recibir invitados</p><h2 class="display">Un pase pensado para <em>la entrada.</em></h2><p class="body-lead">Los pases con QR permiten consultar información asociada a un invitado al momento del acceso. Es una opción para eventos que necesitan organizar el registro de asistentes.</p><div class="access-section__points"><div><Icon name="ticket" size={22}/><span>Pase con información personalizada.</span></div><div><Icon name="qr" size={22}/><span>Código que acompaña el control de acceso.</span></div><div><Icon name="check" size={22}/><span>Consulta de datos al recibir invitados.</span></div></div><a class="text-link" href={contactHref('Hola, CAZAMI. Quiero cotizar pases con QR y control de acceso.')} target="_blank" rel="noopener noreferrer">Cotizar pases con QR <Icon name="arrowUp" size={18}/></a></div><div class="access-visual rise"><span class="access-visual__label">CONTROL DE ACCESO <span> / </span> ESQUEMA EXPLICATIVO</span><div class="access-card"><div class="access-card__head"><span>CAZAMI STUDIO</span><Icon name="ticket" size={22}/></div><div class="access-card__body"><span>VERIFICACIÓN</span><div class="access-card__symbol"><Icon name="qr" size={98}/></div><strong>Una bienvenida organizada</strong><small>INVITADO · PASE · RECEPCIÓN</small></div><div class="access-card__foot">ILUSTRACIÓN INFORMATIVA · NO ES UN PASE REAL</div></div></div></div></div></section>
<section class="reception-section section" id="recepcion"><div class="shell"><div class="section-meta"><span>07 / RECEPCIÓN Y MESAS</span><span>UN RECIBIMIENTO A LA ALTURA DEL MOMENTO</span></div><div class="reception-section__grid"><div class="rise"><p class="kicker">El gran día, mejor organizado</p><h2 class="display">La atención también <em>se diseña.</em></h2><p class="body-lead">Ofrecemos un servicio relacionado con la recepción y asignación de mesas para eventos que requieren una lista organizada de asistentes.</p><a class="btn btn--line" href={contactHref('Hola, CAZAMI. Quiero cotizar recepción y asignación de mesas.')} target="_blank" rel="noopener noreferrer">Consultar este servicio <Icon name="arrowUp" size={18}/></a></div><div class="reception-flow"><div class="reception-flow__item rise"><span>01</span><div class="reception-flow__icon"><Icon name="users" size={25}/></div><div><h3>Lista de asistentes</h3><p>Información reunida para identificar a cada invitado.</p></div></div><div class="reception-flow__item rise"><span>02</span><div class="reception-flow__icon"><Icon name="table" size={25}/></div><div><h3>Asignación de mesas</h3><p>Una distribución clara para consultar dónde corresponde cada persona.</p></div></div><div class="reception-flow__item rise"><span>03</span><div class="reception-flow__icon"><Icon name="heart" size={25}/></div><div><h3>Apoyo en recepción</h3><p>Consulta de los datos necesarios a la llegada.</p></div></div><p class="reception-flow__note">El alcance y la modalidad del servicio se confirman en la cotización.</p></div></div></div></section>
<NfcShowcase/>
<section class="quote-section section" id="cotizacion"><div class="shell"><div class="section-meta section-meta--on-dark"><span>09 / COTIZACIONES</span><span>PROPUESTAS A TU MEDIDA</span></div><div class="quote-section__head rise"><p class="kicker kicker--light">Cada evento es distinto</p><h2 class="display display--light">Sin fórmulas repetidas. <em>Sin precios inventados.</em></h2><p>Cuéntanos qué estás organizando y qué servicios te interesan. Revisamos el alcance y preparamos una cotización personalizada.</p></div><div class="quote-options"><a class="rise" href={contactHref('Hola, CAZAMI. Quiero cotizar una invitación web personalizada.')} target="_blank" rel="noopener noreferrer"><span>01</span><strong>Invitaciones web</strong><small>Diseño y funcionalidades acordadas</small><Icon name="arrowUp" size={20}/></a><a class="rise" href={contactHref('Hola, CAZAMI. Quiero cotizar pases digitales y control de acceso.')} target="_blank" rel="noopener noreferrer"><span>02</span><strong>Pases y QR</strong><small>Personalización y organización</small><Icon name="arrowUp" size={20}/></a><a class="rise" href={contactHref('Hola, CAZAMI. Quiero cotizar tarjetas NFC, recepción y mesas.')} target="_blank" rel="noopener noreferrer"><span>03</span><strong>Servicios adicionales</strong><small>Tarjetas NFC, recepción y mesas</small><Icon name="arrowUp" size={20}/></a></div><p class="quote-section__note">No son paquetes predeterminados. Los precios y características se confirman directamente por WhatsApp.</p></div></section>
<section class="process-section section" id="proceso"><div class="shell"><div class="section-meta"><span>10 / PROCESO DE CONTRATACIÓN</span><span>DEL PRIMER MENSAJE A TU INVITACIÓN</span></div><div class="process-section__intro rise"><p class="kicker">Así construimos tu proyecto</p><h2 class="display">De la primera idea <em>al gran momento.</em></h2></div><div class="process-grid"><div class="rise"><span>01</span><Icon name="send" size={26}/><h3>Nos cuentas</h3><p>Compártenos qué celebras, cuándo será y qué te gustaría transmitir.</p></div><div class="rise"><span>02</span><Icon name="layers" size={26}/><h3>Definimos</h3><p>Acordamos el servicio, sus funcionalidades y la cotización.</p></div><div class="rise"><span>03</span><Icon name="pen" size={26}/><h3>Diseñamos</h3><p>Preparamos el contenido y diseño personalizado de tu proyecto.</p></div><div class="rise"><span>04</span><Icon name="heart" size={26}/><h3>Compartes</h3><p>Tras la aprobación y entrega, lo compartes con tus invitados.</p></div></div></div></section>
<section class="contact-section" id="contacto"><div class="shell contact-section__layout"><div class="rise"><p class="kicker kicker--light">Hagamos algo memorable</p><h2>Todo comienza <em>con un hola.</em></h2><p>Tu historia merece una primera impresión especial. Cuéntanos cómo imaginas tu celebración.</p><div class="contact-section__links"><a class="btn btn--light" href={contactHref('Hola, CAZAMI. Vi el catálogo y quiero cotizar mi evento.')} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={20}/> Solicitar cotización <Icon name="arrowUp" size={18}/></a><a class="text-link text-link--light" href={site.tiktok} target="_blank" rel="noopener noreferrer">Ver TikTok <Icon name="arrowUp" size={18}/></a></div></div><div class="contact-section__logo rise"><img src="/brand/cz-blanco.png" alt="Logotipo oficial de CAZAMI" width="200" height="200"/><span>INVITACIONES DE AUTOR</span><strong>CAZAMI</strong><small>{site.whatsappDisplay}</small></div></div></section>
<script>
const cards=Array.from(document.querySelectorAll<HTMLElement>('[data-work-card]'));
const filters=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
const search=document.getElementById('portfolio-search') as HTMLInputElement|null;
const count=document.getElementById('portfolio-status');const empty=document.getElementById('portfolio-empty');let selected='Todas';
const apply=()=>{const query=(search?.value||'').trim().toLocaleLowerCase('es-MX');let visible=0;cards.forEach(card=>{const match=(selected==='Todas'||card.dataset.category===selected)&&(card.dataset.search||'').includes(query);card.hidden=!match;if(match)visible++;});if(count)count.textContent=`${visible} ${visible===1?'PROYECTO':'PROYECTOS'}`;if(empty)empty.hidden=visible!==0;};
filters.forEach(btn=>btn.addEventListener('click',()=>{selected=btn.dataset.filter||'Todas';filters.forEach(option=>{const current=option===btn;option.classList.toggle('filter-pill--active',current);option.setAttribute('aria-pressed',String(current));});apply();}));search?.addEventListener('input',apply);apply();
</script>
</BaseLayout>

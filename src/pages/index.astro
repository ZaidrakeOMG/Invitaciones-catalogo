---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import InvitationCard from '../components/InvitationCard.astro';
import PassGallery from '../components/PassGallery.astro';
import NfcShowcase from '../components/NfcShowcase.astro';
import {catalog,categories} from '../data/catalog';
import {site,contactHref} from '../data/site';
const capability=[
  {icon:'music',title:'Música',desc:'Una canción especial para acompañar la experiencia.'},
  {icon:'gallery',title:'Galería de fotos',desc:'Tus imágenes favoritas dentro de la invitación.'},
  {icon:'map',title:'Ubicación',desc:'Enlaces a los lugares importantes de tu evento.'},
  {icon:'check',title:'Confirmación',desc:'Una forma sencilla de recibir respuestas de asistencia.'},
  {icon:'pen',title:'Libro de firmas',desc:'Un espacio para conservar mensajes y buenos deseos.'},
  {icon:'ticket',title:'Pases',desc:'Información personalizada por invitado, cuando se contrate.'}
] as const;
const serviceList=[
  {id:'invitaciones-web',index:'01',icon:'smartphone',name:'Invitaciones web',desc:'Una página completamente personalizada para anunciar tu celebración.',label:'Diseño digital'},
  {id:'pases',index:'02',icon:'ticket',name:'Pases digitales',desc:'Una atención especial y datos de acceso para cada invitado.',label:'Personalización'},
  {id:'control',index:'03',icon:'qr',name:'Códigos QR',desc:'Herramientas para consultar pases y organizar la entrada.',label:'Control de acceso'},
  {id:'recepcion',index:'04',icon:'users',name:'Recepción y mesas',desc:'Apoyo en la llegada y organización de tus asistentes.',label:'Organización'},
  {id:'nfc',index:'05',icon:'radio',name:'Tarjetas NFC',desc:'Una invitación semifísica que conecta con tu experiencia web.',label:'Presentación tangible'}
] as const;
---
<BaseLayout>
  <section class="v7-hero" id="inicio" aria-labelledby="v7-title">
    <div class="v7-hero__glow" aria-hidden="true"></div>
    <div class="wrap v7-hero__grid">
      <div class="v7-hero__content">
        <div class="v7-overline v7-overline--light reveal"><span class="v7-overline__line"></span> ESTUDIO CREATIVO DE INVITACIONES</div>
        <p class="v7-hero__edition reveal">EDICIÓN DE AUTOR · CAZAMI</p>
        <h1 class="v7-hero__title reveal" id="v7-title">El arte de <em>invitar.</em></h1>
        <p class="v7-hero__description reveal">Diseñamos primeras impresiones que emocionan. Invitaciones web personalizadas, pases digitales y detalles para hacer inolvidable cada celebración.</p>
        <div class="v7-hero__actions reveal"><a class="v7-btn v7-btn--cream" href="#coleccion">Explora nuestro trabajo <Icon name="arrowUp" size={18}/></a><a class="v7-textlink v7-textlink--light" href="#servicios">Conoce los servicios <Icon name="arrow" size={18}/></a></div>
        <div class="v7-hero__baseline reveal"><span>01 / 11</span><span>DESLIZA PARA DESCUBRIR</span><span class="v7-baseline-line"></span></div>
      </div>
      <div class="v7-hero__art" aria-label="Proyecto destacado Zaid y Camila">
        <div class="v7-hero__orb v7-hero__orb--one"></div><div class="v7-hero__orb v7-hero__orb--two"></div>
        <a class="v7-featured" href="https://zyc-invitacion.netlify.app/" target="_blank" rel="noopener noreferrer" aria-label="Abrir invitación original de Zaid y Camila"><div class="v7-featured__top"><span>PROYECTO DESTACADO</span><Icon name="arrowUp" size={16}/></div><div class="v7-featured__image"><img src="/previews-real/zyc-invitacion.png" alt="Portada real de la invitación web Zaid y Camila" width="451" height="661" fetchpriority="high"/></div><div class="v7-featured__foot"><span>DISEÑO WEB · BODA</span><b>Zaid <i>&</i> Camila</b></div></a>
        <span class="v7-hero__sidecaption">UN EJEMPLO REAL DE NUESTRAS INVITACIONES WEB</span>
      </div>
    </div>
    <div class="v7-hero__bottom"><div class="wrap"><span>HECHO A TU MEDIDA</span><span class="v7-hero__bottom-icon"><Icon name="star" size={15}/></span><span>HECHO PARA RECORDAR</span></div></div>
  </section>
  <section class="v7-intro v7-pad" id="servicios"><div class="wrap"><div class="v7-section-index"><span>01 — QUIÉNES SOMOS</span><span>CAZAMI STUDIO</span></div><div class="v7-intro__row"><div><p class="v7-kicker reveal">BIENVENIDO A UNA NUEVA FORMA DE INVITAR</p><h2 class="v7-heading reveal">Un detalle pequeño. <em>Una emoción enorme.</em></h2></div><div class="v7-intro__text reveal"><p>En CAZAMI creemos que una celebración comienza mucho antes del gran día: comienza cuando alguien recibe una invitación.</p><p>Por eso cuidamos cada detalle, desde la experiencia web hasta la forma de recibir a tus invitados.</p><a class="v7-textlink" href={contactHref('Hola, CAZAMI. Quiero contarles sobre mi evento y solicitar una cotización.')} target="_blank" rel="noopener noreferrer">Cuéntanos tu idea <Icon name="arrowUp" size={17}/></a></div></div><div class="v7-intro__hairline"></div><div class="v7-services-label"><span>LO QUE PODEMOS CREAR JUNTOS</span><span>EXPLORA CADA SERVICIO</span></div><div class="v7-services">{serviceList.map(s=><a href={`#${s.id}`} class="v7-service reveal"><div class="v7-service__top"><span>{s.index}</span><Icon name={s.icon} size={26}/></div><div><small>{s.label}</small><h3>{s.name}</h3><p>{s.desc}</p></div><span class="v7-service__go"><Icon name="arrowUp" size={18}/></span></a>)}</div></div></section>
  <div class="v7-ticker" aria-hidden="true"><div class="v7-ticker__track">CAZAMI &nbsp;·&nbsp; INVITACIONES DE AUTOR &nbsp;✦&nbsp; EXPERIENCIAS PERSONALES &nbsp;✦&nbsp; HECHO PARA TU HISTORIA &nbsp;✦&nbsp; CAZAMI &nbsp;·&nbsp; INVITACIONES DE AUTOR &nbsp;✦&nbsp; EXPERIENCIAS PERSONALES &nbsp;✦&nbsp; HECHO PARA TU HISTORIA &nbsp;✦&nbsp;</div></div>
  <section class="v7-web v7-pad" id="invitaciones-web"><div class="wrap"><div class="v7-section-index"><span>02 — INVITACIONES WEB</span><span>DISEÑO DE AUTOR</span></div><div class="v7-web__grid"><div class="v7-web__visual reveal"><div class="v7-web__halo"></div><div class="v7-web__device"><div class="v7-web__device-top"><span></span><span></span><span></span></div><img src="/previews-real/zyc-invitacion.png" width="451" height="661" loading="lazy" alt="Ejemplo auténtico de portada de la invitación web de Zaid y Camila"/><div class="v7-web__device-bottom"></div></div><span class="v7-web__counter">ESTUDIO / 001</span><div class="v7-web__caption">Zaid & Camila<span>DEMOSTRACIÓN PUBLICADA</span></div></div><div class="v7-web__copy"><span class="v7-kicker reveal"><Icon name="sparkles" size={15}/> UNA EXPERIENCIA HECHA PARA TI</span><h2 class="v7-heading reveal">No es solo un enlace. <em>Es el inicio de tu historia.</em></h2><p class="v7-lead reveal">Una invitación digital creada alrededor del estilo y la personalidad de tu evento, que tus invitados pueden abrir fácilmente desde su teléfono.</p><div class="v7-web__facts"><div class="reveal"><span>01 / PERSONALIZACIÓN</span><strong>Un diseño con identidad</strong><p>Una presentación visual adaptada a la celebración que estás planeando.</p></div><div class="reveal"><span>02 / EXPERIENCIA</span><strong>Una web para compartir</strong><p>El enlace reúne los detalles que necesitas comunicar a tus invitados.</p></div><div class="reveal"><span>03 / POSIBILIDADES</span><strong>Funciones según tu proyecto</strong><p>La música, fotos, mapas y otras herramientas se definen al cotizar.</p></div></div><a class="v7-btn v7-btn--dark" href="https://zyc-invitacion.netlify.app/" target="_blank" rel="noopener noreferrer">Ver esta invitación real <Icon name="arrowUp" size={18}/></a></div></div></div></section>
  <section class="v7-features v7-pad" id="funciones"><div class="wrap"><div class="v7-section-index"><span>03 — FUNCIONALIDADES</span><span>DETALLES QUE HACEN LA DIFERENCIA</span></div><div class="v7-features__heading"><div><span class="v7-kicker reveal">TU HISTORIA EN CADA DETALLE</span><h2 class="v7-heading reveal">Cada elemento, <em>con intención.</em></h2></div><div class="v7-features__explain reveal"><p>Una invitación puede tener distintas funciones interactivas. Elegimos contigo las que mejor acompañen tu celebración.</p><span><Icon name="shield" size={18}/> Funciones sujetas al alcance de cada cotización.</span></div></div><div class="v7-features__grid">{capability.map((feature,index)=><article class="v7-feature reveal"><div class="v7-feature__top"><span>{String(index+1).padStart(2,'0')}</span><Icon name={feature.icon} size={26}/></div><div><h3>{feature.title}</h3><p>{feature.desc}</p></div></article>)}</div><div class="v7-features__bottom"><p>Tu celebración es única. Tu invitación también puede serlo.</p><a class="v7-textlink" href={contactHref('Hola, CAZAMI. Quiero conocer las funcionalidades disponibles para mi invitación.')} target="_blank" rel="noopener noreferrer">Consultar funcionalidades <Icon name="arrowUp" size={17}/></a></div></div></section>
  <section class="v7-portfolio v7-pad" id="coleccion"><div class="wrap"><div class="v7-section-index"><span>04 — EL PORTAFOLIO</span><span>14 HISTORIAS / DEMOS ORIGINALES</span></div><div class="v7-portfolio__head"><div><span class="v7-kicker reveal">UNA SELECCIÓN DE NUESTROS TRABAJOS</span><h2 class="v7-heading reveal">Ideas que ya <em>cobraron vida.</em></h2></div><p class="reveal">Explora nuestras invitaciones web reales. Las vistas dentro del catálogo no permiten interacción; para vivir cada experiencia completa, abre su demostración original.</p></div><div class="v7-portfolio__toolbar"><div class="filterbar" aria-label="Filtrar portafolio">{categories.map((cat,index)=><button type="button" class:list={['filterbtn',{'filterbtn--active':index===0}]} data-filter={cat} aria-pressed={index===0}>{cat}</button>)}</div><label class="v7-portfolio__search"><Icon name="sparkles" size={17}/><input id="work-search" type="search" placeholder="Buscar invitación..." aria-label="Buscar proyectos" autocomplete="off"/></label></div><div class="v7-portfolio__counter"><span id="portfolio-count">MOSTRANDO 14 PROYECTOS</span><span>TOCA UN PROYECTO PARA EXPLORAR</span></div><div class="works-grid" id="works-grid">{catalog.map((item,index)=><InvitationCard item={item} index={index}/>)}</div><p class="portfolio-empty" id="portfolio-empty" hidden>No encontramos proyectos con ese filtro. Prueba con otra categoría.</p><div class="v7-portfolio__note"><Icon name="shield" size={19}/><p><strong>Vistas de las invitaciones web:</strong> Zaid & Camila cuenta con una captura real de portada. En los demás proyectos se intenta mostrar el sitio original; algunos pueden restringir su visualización. Todas las demostraciones pueden abrirse con su enlace. <strong>Los ejemplos de pases digitales se muestran exclusivamente en la siguiente sección.</strong></p></div></div></section>
  <PassGallery/>
  <section class="v7-qr v7-pad" id="control"><div class="wrap"><div class="v7-section-index v7-section-index--light"><span>06 — QR Y CONTROL DE ACCESO</span><span>ORGANIZACIÓN DE INVITADOS</span></div><div class="v7-qr__grid"><div class="v7-qr__copy"><span class="v7-kicker v7-kicker--light reveal">CADA INVITADO, UN ACCESO CLARO</span><h2 class="v7-heading v7-heading--light reveal">Una entrada organizada. <em>Una bienvenida perfecta.</em></h2><p class="v7-lead reveal">Los pases con código QR ayudan a identificar a los asistentes y consultar los datos correspondientes durante la recepción.</p><div class="v7-qr__points"><div><Icon name="ticket" size={22}/><span>Pase digital con la información del invitado</span></div><div><Icon name="qr" size={22}/><span>Presentación del código QR en el acceso</span></div><div><Icon name="check" size={22}/><span>Consulta para verificar la información del pase</span></div></div><a class="v7-btn v7-btn--outline" href={contactHref('Hola, CAZAMI. Quiero cotizar pases digitales con QR y control de acceso.')} target="_blank" rel="noopener noreferrer">Cotizar control de acceso <Icon name="arrowUp" size={18}/></a></div><div class="v7-qr__visual reveal"><div class="v7-qr__finecircle"></div><div class="v7-qr__card"><div class="v7-qr__cardtop"><span>CAZAMI STUDIO</span><Icon name="sparkles" size={19}/></div><div class="v7-qr__cardbody"><span>VISTA ILUSTRATIVA</span><div class="v7-qr__drawncode"><Icon name="qr" size={115}/></div><b>Acceso organizado</b><small>PASE · VERIFICACIÓN · RECEPCIÓN</small></div><div class="v7-qr__cardfoot"><span>ESQUEMA EXPLICATIVO</span><span>NO ES UN PASE VÁLIDO</span></div></div><div class="v7-qr__orbit">UNA EXPERIENCIA MÁS TRANQUILA PARA TODOS</div></div></div><div class="v7-qr__steps"><div><span>01</span><strong>Preparamos</strong><p>Definimos los datos y la información de acceso del evento.</p></div><div><span>02</span><strong>Compartes</strong><p>Cada invitado recibe el pase digital correspondiente.</p></div><div><span>03</span><strong>Recibes</strong><p>En la llegada, se consulta la información del pase.</p></div></div></div></section>
  <section class="v7-reception v7-pad" id="recepcion"><div class="wrap"><div class="v7-section-index"><span>07 — RECEPCIÓN Y MESAS</span><span>ATENCIÓN AL DETALLE</span></div><div class="v7-reception__grid"><div class="v7-reception__intro"><span class="v7-kicker reveal">LA EXPERIENCIA TAMBIÉN CONTINÚA AL LLEGAR</span><h2 class="v7-heading reveal">La primera bienvenida <em>también importa.</em></h2><p class="v7-lead reveal">El servicio de recepción y organización de mesas está pensado para eventos que requieren identificar invitados y consultar su distribución.</p><a class="v7-textlink" href={contactHref('Hola, CAZAMI. Quiero cotizar recepción de invitados y asignación de mesas.')} target="_blank" rel="noopener noreferrer">Cotizar recepción y mesas <Icon name="arrowUp" size={19}/></a></div><div class="v7-reception__right"><div class="v7-reception__label">UN PROCESO MÁS CLARO PARA TU EVENTO</div><div class="v7-reception__item reveal"><div class="v7-reception__icon"><Icon name="users" size={27}/></div><div><span>PRIMER PASO</span><h3>Lista de invitados</h3><p>Información organizada para identificar a cada asistente.</p></div></div><div class="v7-reception__item reveal"><div class="v7-reception__icon"><Icon name="table" size={27}/></div><div><span>SEGUNDO PASO</span><h3>Asignación de mesas</h3><p>Distribución acordada para facilitar la ubicación de invitados.</p></div></div><div class="v7-reception__item reveal"><div class="v7-reception__icon"><Icon name="heart" size={27}/></div><div><span>EL GRAN DÍA</span><h3>Apoyo en recepción</h3><p>Consulta de los datos necesarios para orientar la llegada.</p></div></div><div class="v7-reception__footnote">El alcance del servicio se confirma al cotizar.</div></div></div></div></section>
  <NfcShowcase/>
  <section class="v7-pricing v7-pad" id="cotizacion"><div class="wrap"><div class="v7-section-index"><span>09 — SOLUCIONES PERSONALIZADAS</span><span>PRECIOS BAJO COTIZACIÓN</span></div><div class="v7-pricing__head"><div><span class="v7-kicker reveal">CADA CELEBRACIÓN ES DIFERENTE</span><h2 class="v7-heading reveal">Tu evento. <em>Tu propuesta.</em></h2></div><p class="reveal">No ofrecemos un paquete genérico para todos. Revisamos contigo los servicios que necesitas y preparamos una cotización conforme a su alcance.</p></div><div class="v7-pricing__rows"><a href={contactHref('Hola, CAZAMI. Quiero cotizar una invitación web personalizada.')} target="_blank" rel="noopener noreferrer"><span>01</span><div><h3>Invitación web personalizada</h3><p>Diseño digital y funciones acordadas para tu celebración.</p></div><small>COTIZAR</small><Icon name="arrowUp" size={22}/></a><a href={contactHref('Hola, CAZAMI. Quiero cotizar pases digitales y control de acceso.')} target="_blank" rel="noopener noreferrer"><span>02</span><div><h3>Pases digitales y acceso</h3><p>Personalización de pases y opciones de control con QR.</p></div><small>COTIZAR</small><Icon name="arrowUp" size={22}/></a><a href={contactHref('Hola, CAZAMI. Quiero cotizar tarjetas NFC, recepción y asignación de mesas.')} target="_blank" rel="noopener noreferrer"><span>03</span><div><h3>Servicios complementarios</h3><p>Tarjetas NFC, recepción y organización de mesas.</p></div><small>COTIZAR</small><Icon name="arrowUp" size={22}/></a></div><p class="v7-pricing__note"><Icon name="shield" size={16}/> Los apartados describen áreas de servicio, no paquetes con precios ni características preestablecidas.</p></div></section>
  <section class="v7-process v7-pad" id="proceso"><div class="wrap"><div class="v7-section-index v7-section-index--light"><span>10 — NUESTRO PROCESO</span><span>DEL PRIMER MENSAJE A LA ENTREGA</span></div><div class="v7-process__top"><div><span class="v7-kicker v7-kicker--light reveal">SENCILLO, CLARO, PERSONAL</span><h2 class="v7-heading v7-heading--light reveal">De una idea a <em>algo inolvidable.</em></h2></div><p>Nos cuentas qué imaginas para tu evento y definimos contigo cómo convertirlo en una experiencia digital.</p></div><div class="v7-process__steps"><article class="reveal"><span>01</span><Icon name="send" size={24}/><h3>Cuéntanos</h3><p>Comparte el tipo de evento, la fecha y el estilo que tienes en mente.</p></article><article class="reveal"><span>02</span><Icon name="layers" size={24}/><h3>Definimos</h3><p>Revisamos servicios, funcionalidades y cotización.</p></article><article class="reveal"><span>03</span><Icon name="pen" size={24}/><h3>Diseñamos</h3><p>Trabajamos la identidad y el contenido de tu proyecto.</p></article><article class="reveal"><span>04</span><Icon name="heart" size={24}/><h3>Compartes</h3><p>Tras la aprobación y entrega, haces llegar la experiencia a tus invitados.</p></article></div></div></section>
  <section class="v7-contact v7-pad" id="contacto"><div class="wrap"><div class="v7-section-index"><span>11 — HABLEMOS DE TU EVENTO</span><span>ESCRÍBENOS</span></div><div class="v7-contact__grid"><div><span class="v7-kicker reveal">TU HISTORIA EMPIEZA AQUÍ</span><h2 class="v7-heading reveal">Lo extraordinario <em>comienza con una invitación.</em></h2><p class="reveal">¿Boda, XV años o una celebración especial? Cuéntanos tu idea. Será un gusto diseñar contigo una propuesta a tu medida.</p><div class="v7-contact__actions"><a class="v7-btn v7-btn--dark" href={contactHref('Hola, CAZAMI. Vi su catálogo y quiero una cotización personalizada para mi evento.')} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={19}/> Solicitar cotización <Icon name="arrowUp" size={18}/></a><a class="v7-textlink" href={site.tiktok} target="_blank" rel="noopener noreferrer">Ver nuestro TikTok <Icon name="arrowUp" size={18}/></a></div></div><div class="v7-contact__identity reveal"><div class="v7-contact__monogram"><img src="/brand/cz-blanco.png" alt="Monograma oficial CAZAMI" width="150" height="150"/></div><span>INVITACIONES DE AUTOR</span><strong>CAZAMI</strong><small>ESTUDIO CREATIVO PARA CELEBRACIONES</small><a href={contactHref()} target="_blank" rel="noopener noreferrer">{site.whatsappDisplay} <Icon name="arrowUp" size={18}/></a></div></div></div></section>
<script>
 const cards=Array.from(document.querySelectorAll<HTMLElement>('[data-work-card]'));
 const filters=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
 const search=document.getElementById('work-search') as HTMLInputElement|null;
 const count=document.getElementById('portfolio-count');const empty=document.getElementById('portfolio-empty');let category='Todas';
 const refresh=()=>{const q=(search?.value||'').trim().toLocaleLowerCase('es-MX');let total=0;cards.forEach(card=>{const match=(category==='Todas'||card.dataset.category===category)&&(card.dataset.search||'').includes(q);card.hidden=!match;if(match)total++;});if(count)count.textContent=`MOSTRANDO ${total} ${total===1?'PROYECTO':'PROYECTOS'}`;if(empty)empty.hidden=total>0;};
 filters.forEach(btn=>btn.addEventListener('click',()=>{category=btn.dataset.filter||'Todas';filters.forEach(b=>{const current=b===btn;b.classList.toggle('filterbtn--active',current);b.setAttribute('aria-pressed',String(current));});refresh();}));search?.addEventListener('input',refresh);refresh();
 const previews=Array.from(document.querySelectorAll<HTMLElement>('[data-web-preview]'));
 const activate=(host:HTMLElement)=>{const frame=host.querySelector<HTMLIFrameElement>('iframe[data-src]');if(!frame||frame.hasAttribute('src'))return;frame.style.transform=`scale(${host.getBoundingClientRect().width/390})`;frame.src=frame.dataset.src||'';};
 if('ResizeObserver' in window){const ro=new ResizeObserver(entries=>entries.forEach(entry=>{const frame=entry.target.querySelector<HTMLIFrameElement>('iframe[data-src]');if(frame)frame.style.transform=`scale(${entry.contentRect.width/390})`;}));previews.forEach(host=>ro.observe(host));}
 if('IntersectionObserver' in window){const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){activate(entry.target as HTMLElement);observer.unobserve(entry.target);}}),{rootMargin:'180px 0px'});previews.forEach(host=>observer.observe(host));}else previews.forEach(activate);
</script>
</BaseLayout>

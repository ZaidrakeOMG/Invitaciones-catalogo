---
import BaseLayout from '../layouts/BaseLayout.astro';
import InvitationCard from '../components/InvitationCard.astro';
import PassGallery from '../components/PassGallery.astro';
import UiIcon from '../components/UiIcon.astro';
import { catalog, categories } from '../data/catalog';
import { contactHref } from '../data/site';
---
<BaseLayout title="Catálogo de invitaciones y pases | CAZAMI STUDIO" description="Una selección de invitaciones digitales y pases personalizados que hemos creado en CAZAMI Studio.">
  <section class="catalog-hero" id="inicio">
    <div class="wrap catalog-hero__inner">
      <div class="catalog-hero__copy">
        <span class="catalog-hero__eyebrow"><UiIcon name="sparkles" size={14}/> CAZAMI STUDIO · PORTAFOLIO</span>
        <h1>Detalles que<br />hacen <em>magia.</em></h1>
        <p>Un vistazo a las invitaciones y pases que hemos creado para momentos inolvidables.</p>
        <div class="catalog-hero__actions"><a class="button button--cream" href="#coleccion">Explorar invitaciones ↗</a><a class="catalog-hero__link" href="#pases">Ver nuestros pases ↘</a></div>
        <div class="catalog-hero__notes"><span><UiIcon name="link" size={14}/> Invitaciones digitales</span><span><UiIcon name="ticket" size={14}/> Pases personalizados</span></div>
      </div>
      <div class="catalog-hero__art" aria-hidden="true">
        <div class="hero-art__frame hero-art__frame--left" style="background-image:url('/previews/invitacion-romina-xv.svg')"><img src="/invitation-previews/invitacion-romina-xv.webp" alt="" onerror="this.hidden=true" /><span class="hero-art__name">Romina</span></div>
        <div class="hero-art__frame hero-art__frame--right" style="background-image:url('/previews/inv-minecraft.svg')"><img src="/invitation-previews/inv-minecraft.webp" alt="" onerror="this.hidden=true" /><span class="hero-art__name">Minecraft</span></div>
        <div class="hero-art__frame hero-art__frame--center"><img src="/previews-real/zyc-invitacion.webp" alt="" /><span class="hero-art__name">Zaid & Camila</span></div>
        <div class="hero-art__seal"><span>CREADO POR</span><UiIcon name="sparkles" size={30}/><span>CAZAMI</span></div>
      </div>
    </div>
    <div class="catalog-hero__bottom wrap"><span>DISEÑAMOS HISTORIAS, NO SOLO INVITACIONES</span><span>DESLIZA PARA DESCUBRIR ↓</span></div>
  </section>

  <section class="portfolio section-space" id="coleccion" aria-labelledby="portfolio-title">
    <div class="wrap">
      <div class="section-bar"><span>01 / NUESTROS TRABAJOS</span><span>INVITACIONES DIGITALES</span></div>
      <div class="catalog-heading"><div><span class="catalog-heading__eyebrow"><UiIcon name="grid" size={14}/> ALGUNOS DE NUESTROS TRABAJOS</span><h2 class="display-title" id="portfolio-title">Invitaciones que <em>enamoran.</em></h2></div><p>Elige tu favorita y descubre cada detalle.</p></div>
      <div class="portfolio-controls"><div class="filterbar" aria-label="Filtrar invitaciones">{categories.map((cat,index)=><button type="button" class:list={['filterbtn',{'filterbtn--active':index===0}]} data-filter={cat} aria-pressed={index===0}>{cat}</button>)}</div><label class="portfolio-search"><span aria-hidden="true">⌕</span><input id="work-search" type="search" placeholder="Buscar invitación" aria-label="Buscar invitaciones" autocomplete="off" /></label></div>
      <p class="portfolio-count" id="portfolio-count">MOSTRANDO {catalog.length} INVITACIONES</p>
      <div class="works-grid" id="works-grid">{catalog.map((item,index)=><InvitationCard item={item} index={index} />)}</div>
      <p class="portfolio-empty" id="portfolio-empty" hidden>No encontramos invitaciones con esa búsqueda.</p>
      <nav class="catalog-pagination" id="portfolio-pagination" aria-label="Páginas de invitaciones">
        <button type="button" id="invite-prev" class="catalog-pagination__button" disabled>← Anterior</button>
        <span id="invite-page-label" class="catalog-pagination__label" role="status" aria-live="polite">Página 1 de {Math.max(1,Math.ceil(catalog.length/9))}</span>
        <button type="button" id="invite-next" class="catalog-pagination__button">Siguiente →</button>
      </nav>
    </div>
  </section>

  <PassGallery />

  <section class="catalog-contact" id="cotizacion"><div class="wrap catalog-contact__inner"><div><span class="eyebrow">TU EVENTO, TU ESTILO</span><h2>¿Creamos el tuyo?</h2><p>Invitaciones y pases digitales personalizados para tu celebración.</p></div><a class="button button--cream" href={contactHref('Hola, CAZAMI. Vi su catálogo de trabajos y quiero cotizar una invitación o pases digitales.')} target="_blank" rel="noopener noreferrer">Cotizar por WhatsApp ↗</a></div></section>

  <script>
    type ExtraInvite = {id:string;name:string;category:string;url:string};
    type ExtraPass = {id:string;image:string};
    const grid=document.getElementById('works-grid');
    const count=document.getElementById('portfolio-count');
    const empty=document.getElementById('portfolio-empty');
    const search=document.getElementById('work-search') as HTMLInputElement|null;
    const filterButtons=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    let category='Todas';
    let page=1;
    const pageSize=9;
    const prevButton=document.getElementById('invite-prev') as HTMLButtonElement|null;
    const nextButton=document.getElementById('invite-next') as HTMLButtonElement|null;
    const pageLabel=document.getElementById('invite-page-label');
    function redraw(){
      const q=(search?.value||'').trim().toLocaleLowerCase('es-MX');
      const matches=Array.from(grid?.querySelectorAll<HTMLElement>('[data-work-card]')||[]).filter(card=>
        (category==='Todas'||category===card.dataset.category)&&(card.dataset.search||'').includes(q));
      const pages=Math.max(1,Math.ceil(matches.length/pageSize));
      page=Math.min(Math.max(page,1),pages);
      const start=(page-1)*pageSize;
      const visible=new Set(matches.slice(start,start+pageSize));
      grid?.querySelectorAll<HTMLElement>('[data-work-card]').forEach(card=>{
        card.hidden=!visible.has(card);
        if(visible.has(card))card.classList.add('visible');
      });
      if(count)count.textContent=`MOSTRANDO ${matches.length?start+1:0}–${Math.min(start+pageSize,matches.length)} DE ${matches.length} INVITACIONES`;
      if(empty)empty.hidden=matches.length>0;
      if(pageLabel)pageLabel.textContent=`Página ${page} de ${pages}`;
      if(prevButton)prevButton.disabled=page<=1;
      if(nextButton)nextButton.disabled=page>=pages;
    }
    filterButtons.forEach(button=>button.addEventListener('click',()=>{
      category=button.dataset.filter||'Todas';page=1;
      filterButtons.forEach(b=>{const active=b===button;b.classList.toggle('filterbtn--active',active);b.setAttribute('aria-pressed',String(active));});redraw();
    }));
    search?.addEventListener('input',()=>{page=1;redraw();});
    const goPage=(delta:number)=>{page+=delta;redraw();document.getElementById('coleccion')?.scrollIntoView({behavior:'smooth',block:'start'});};
    prevButton?.addEventListener('click',()=>goPage(-1));
    nextButton?.addEventListener('click',()=>goPage(1));
    function addInvite(item:ExtraInvite,index:number){
      if(!grid||!/^https:\/\//i.test(item.url))return;
      const article=document.createElement('article');article.className='work-card reveal visible';article.dataset.workCard='';article.dataset.category=item.category;
      article.dataset.search=`${item.name} ${item.category}`.toLocaleLowerCase('es-MX');
      const link=document.createElement('a');link.className='work-card__cover';link.href=item.url;link.target='_blank';link.rel='noopener noreferrer';link.setAttribute('aria-label',`Abrir invitación de ${item.name}`);
      const preview=document.createElement('div');preview.className='web-preview invitation-preview web-preview--card';
      const placeholder=document.createElement('div');placeholder.className='invitation-preview__fallback';
      const eyebrow=document.createElement('span');eyebrow.className='invitation-preview__kind';eyebrow.textContent='INVITACIÓN DIGITAL';
      const name=document.createElement('strong');name.textContent=item.name;
      const hint=document.createElement('span');hint.className='invitation-preview__cta';hint.textContent='Toca para ver la invitación';
      placeholder.append(eyebrow,name,hint);
      const image=document.createElement('img');image.className='web-preview__actual invitation-preview__screenshot';image.alt=`Vista de la invitación digital ${item.name}`;image.loading='lazy';image.decoding='async';image.src=`/invitation-previews/nuevo-${item.id}.webp`;image.onerror=()=>{image.hidden=true;};
      const blocker=document.createElement('div');blocker.className='web-preview__blocker';preview.append(placeholder,image,blocker);
      const ordinal=document.createElement('span');ordinal.className='work-card__ordinal';ordinal.textContent=String(index+1).padStart(2,'0');link.append(preview,ordinal);
      const info=document.createElement('div');info.className='work-card__info';
      const type=document.createElement('p');type.className='eyebrow';type.textContent=item.category;
      const title=document.createElement('h3');title.textContent=item.name;
      const actions=document.createElement('div');actions.className='work-card__links';
      const open=document.createElement('a');open.href=item.url;open.target='_blank';open.rel='noopener noreferrer';open.textContent='Abrir invitación ↗';
      actions.append(open);info.append(type,title,actions);article.append(link,info);grid.append(article);

    }
    fetch('/data/catalogo-adicional.json',{cache:'no-store'}).then(async response=>{
      if(!response.ok)return;
      const extra=await response.json() as {invitaciones?:ExtraInvite[];pases?:ExtraPass[]};
      const initial=grid?.querySelectorAll('[data-work-card]').length||0;
      (extra.invitaciones||[]).forEach((item,i)=>addInvite(item,initial+i));
      const rail=document.getElementById('passes-rail');
      (extra.pases||[]).forEach((pass)=>{
        if(!rail||!/^\/passes\/nuevos\/[a-z0-9-]+\.(?:png|jpe?g|webp)$/i.test(pass.image))return;
        const fig=document.createElement('figure');fig.className='pass-card';
        const button=document.createElement('button');button.type='button';button.className='pass-card__image';button.dataset.viewPass='';button.dataset.img=pass.image;button.dataset.name='Pase digital';button.setAttribute('aria-label','Ampliar pase digital');
        const mockup=document.createElement('span');mockup.className='pass-card__mockup';const img=document.createElement('img');img.src=pass.image;img.loading='lazy';img.alt='Pase digital realizado por CAZAMI';mockup.append(img);
        const zoom=document.createElement('span');zoom.className='pass-card__zoom';zoom.textContent='VER COMPLETO ↗';button.append(mockup,zoom);fig.append(button);rail.append(fig);
      });redraw();
    }).catch(()=>{/* Las muestras originales continúan visibles sin conexión. */});
    redraw();

  </script>
</BaseLayout>

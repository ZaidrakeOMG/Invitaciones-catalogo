---
import BaseLayout from '../layouts/BaseLayout.astro';
import InvitationCard from '../components/InvitationCard.astro';
import PassGallery from '../components/PassGallery.astro';
import UiIcon from '../components/UiIcon.astro';
import { catalog, categories } from '../data/catalog';
import { contactHref } from '../data/site';
---
<BaseLayout title="Catálogo de invitaciones y pases | CAZAMI STUDIO" description="Una selección de invitaciones digitales y pases personalizados que hemos creado en CAZAMI Studio.">
  <section class="catalog-hero" id="inicio">
    <div class="wrap catalog-hero__inner">
      <div class="catalog-hero__copy">
        <span class="catalog-hero__eyebrow"><UiIcon name="sparkles" size={15}/> INVITACIONES DIGITALES DE AUTOR</span>
        <h1>El arte de<br /><em>invitar.</em></h1>
        <p class="catalog-hero__lead">Tu celebración empieza mucho antes del gran día. Creamos invitaciones digitales que despiertan emociones desde el primer instante.</p>
        <div class="catalog-hero__actions">
          <a class="button button--cream" href="#coleccion">Explorar la colección <UiIcon name="arrow" size={18}/></a>
          <a class="catalog-hero__link" href={contactHref('Hola, CAZAMI. Me gustaría crear una invitación digital personalizada para mi evento.')} target="_blank" rel="noopener noreferrer">Diseñemos la tuya <UiIcon name="external" size={16}/></a>
        </div>
        <div class="catalog-hero__notes">
          <span><UiIcon name="sparkles" size={14}/> Diseños a tu estilo</span>
          <span><UiIcon name="link" size={14}/> Experiencias interactivas</span>
          <span><UiIcon name="ticket" size={14}/> Pases personalizados</span>
        </div>
      </div>
      <div class="catalog-hero__art" aria-label="Muestra de invitaciones reales de CAZAMI">
        <div class="hero-art__frame hero-art__frame--left" data-hero-preview="left">
          <img src="/invitation-previews/nuevo-db1f0763-9436-4f5a-afe5-67de3c2394a6.jpg" alt="Ejemplo de invitación Baby Shower de Fresitas" loading="eager" />
          <span class="hero-art__name">Baby Shower</span>
        </div>
        <div class="hero-art__frame hero-art__frame--right" data-hero-preview="right">
          <img src="/invitation-previews/nuevo-3acbe3b2-951a-4cd4-a16e-9d5669f21591.jpg" alt="Ejemplo de invitación Zoe" loading="eager" />
          <span class="hero-art__name">XV años</span>
        </div>
        <div class="hero-art__frame hero-art__frame--center" data-hero-preview="center">
          <img src="/invitation-previews/nuevo-133b68a6-6874-4f32-aceb-303a317ebbe5.jpg" alt="Ejemplo de invitación de boda Amor Eterno" loading="eager" />
          <span class="hero-art__name">Bodas</span>
        </div>
        <div class="hero-art__seal" aria-hidden="true"><span>ESTUDIO</span><UiIcon name="sparkles" size={28}/><span>CAZAMI</span></div>
        <span class="hero-art__caption" aria-hidden="true">PORTAFOLIO DE EXPERIENCIAS</span>
      </div>
    </div>
    <div class="catalog-hero__bottom wrap"><span>DISEÑAMOS HISTORIAS, NO SOLO INVITACIONES</span><span>DESLIZA PARA DESCUBRIR <UiIcon name="arrow-down" size={14}/></span></div>
  </section>

  <div class="studio-intro-ribbon" aria-hidden="true">
    <div class="wrap studio-intro-ribbon__inner"><span>EL ARTE DE CELEBRAR</span><span>DETALLES QUE EMOCIONAN</span><span>HECHO PARA TU HISTORIA</span></div>
  </div>

  <section class="studio-values" aria-label="Así diseñamos en CAZAMI">
    <div class="wrap studio-values__inner">
      <div class="studio-value"><span class="studio-value__number">01</span><div><strong>Con personalidad</strong><p>Cada invitación refleja el estilo de tu evento.</p></div></div>
      <div class="studio-value"><span class="studio-value__number">02</span><div><strong>Para sentirla</strong><p>Más que una tarjeta: una experiencia interactiva.</p></div></div>
      <div class="studio-value"><span class="studio-value__number">03</span><div><strong>Para compartirla</strong><p>Un detalle especial que llega a quienes más quieres.</p></div></div>
    </div>
  </section>


  <section class="featured-edition" id="novedades" aria-labelledby="featured-title">
    <div class="wrap">
      <div class="featured-edition__intro">
        <div>
          <span class="featured-edition__eyebrow"><UiIcon name="sparkles" size={15}/> LO MÁS RECIENTE EN CAZAMI</span>
          <h2 id="featured-title">Nuestra última <em>inspiración.</em></h2>
        </div>
        <div class="featured-edition__aside">
          <p>Experiencias digitales creadas para contar historias que merecen celebrarse.</p>
          <a href="#coleccion">Ver toda la colección <UiIcon name="arrow-right" size={16}/></a>
        </div>
      </div>
      <div class="featured-edition__grid" id="featured-edition-grid" aria-label="Invitaciones recientes">
        <a class="featured-piece featured-piece--hero" data-feature="0" href="https://inv-boda-ayi-c13.netlify.app/" target="_blank" rel="noopener noreferrer" aria-label="Explorar la invitación Amor Eterno">
          <img data-feature-img src="/invitation-previews/nuevo-133b68a6-6874-4f32-aceb-303a317ebbe5.jpg" alt="Portada de la invitación Amor Eterno" loading="lazy" decoding="async"/>
          <span class="featured-piece__shade"></span>
          <span class="featured-piece__index">01 / EDICIÓN RECIENTE</span>
          <span class="featured-piece__detail"><span data-feature-category>BODAS</span><strong data-feature-name>Amor Eterno</strong><span class="featured-piece__view">Descubrir invitación <UiIcon name="arrow-right" size={17}/></span></span>
        </a>
        <a class="featured-piece featured-piece--secondary" data-feature="1" href="https://inv-xv-zoe-c12.netlify.app/" target="_blank" rel="noopener noreferrer" aria-label="Explorar la invitación Destellos de Ensueño">
          <img data-feature-img src="/invitation-previews/nuevo-3acbe3b2-951a-4cd4-a16e-9d5669f21591.jpg" alt="Portada de la invitación Destellos de Ensueño" loading="lazy" decoding="async"/>
          <span class="featured-piece__shade"></span>
          <span class="featured-piece__index">02 / EDICIÓN RECIENTE</span>
          <span class="featured-piece__detail"><span data-feature-category>XV AÑOS</span><strong data-feature-name>Destellos de Ensueño</strong><span class="featured-piece__view">Descubrir invitación <UiIcon name="arrow-right" size={17}/></span></span>
        </a>
        <a class="featured-piece featured-piece--secondary" data-feature="2" href="https://inv-fatima-xv-c10.netlify.app/" target="_blank" rel="noopener noreferrer" aria-label="Explorar la invitación El Sueño de Fátima">
          <img data-feature-img src="/invitation-previews/nuevo-c09cbc5a-33da-4b28-83ae-9415f25b9ca9.jpg" alt="Portada de la invitación El Sueño de Fátima" loading="lazy" decoding="async"/>
          <span class="featured-piece__shade"></span>
          <span class="featured-piece__index">03 / EDICIÓN RECIENTE</span>
          <span class="featured-piece__detail"><span data-feature-category>XV AÑOS</span><strong data-feature-name>El Sueño de Fátima</strong><span class="featured-piece__view">Descubrir invitación <UiIcon name="arrow-right" size={17}/></span></span>
        </a>
      </div>
      <p class="featured-edition__swipe"><UiIcon name="arrow-right" size={15}/> Desliza para descubrir más diseños</p>
    </div>
  </section>

  <section class="portfolio section-space" id="coleccion" aria-labelledby="portfolio-title">
    <div class="wrap">
      <div class="section-bar"><span>01 / NUESTROS TRABAJOS</span><span>INVITACIONES DIGITALES</span></div>
      <div class="catalog-heading"><div><span class="catalog-heading__eyebrow"><UiIcon name="grid" size={14}/> NUESTRA COLECCIÓN</span><h2 class="display-title" id="portfolio-title">Momentos que <em>inspiran.</em></h2></div><p>Explora invitaciones reales, descubre cada detalle y encuentra ese diseño que conecta contigo.</p></div>
      <div class="portfolio-controls"><div class="filterbar" aria-label="Filtrar invitaciones">{categories.map((cat,index)=><button type="button" class:list={['filterbtn',{'filterbtn--active':index===0}]} data-filter={cat} aria-pressed={index===0}>{cat}</button>)}</div><label class="portfolio-search"><UiIcon name="search" size={16}/><input id="work-search" type="search" placeholder="Busca por nombre o evento" aria-label="Buscar invitaciones" autocomplete="off" /></label></div>
      <p class="portfolio-count" id="portfolio-count">MOSTRANDO {catalog.length} INVITACIONES</p>
      <div class="works-grid" id="works-grid">{catalog.map((item,index)=><InvitationCard item={item} index={index} />)}</div>
      <p class="portfolio-empty" id="portfolio-empty" hidden>No encontramos invitaciones con esa búsqueda.</p>
      <nav class="catalog-pagination" id="portfolio-pagination" aria-label="Páginas de invitaciones">
        <button type="button" id="invite-prev" class="catalog-pagination__button" disabled><UiIcon name="arrow-left" size={15}/> Anterior</button>
        <span id="invite-page-label" class="catalog-pagination__label" role="status" aria-live="polite">Página 1 de {Math.max(1,Math.ceil(catalog.length/9))}</span>
        <button type="button" id="invite-next" class="catalog-pagination__button">Siguiente <UiIcon name="arrow-right" size={15}/></button>
      </nav>
    </div>
  </section>

  <PassGallery />

  <section class="studio-process" id="proceso" aria-labelledby="process-title">
    <div class="wrap">
      <div class="studio-process__top">
        <div><span class="eyebrow">ASÍ NACE TU INVITACIÓN</span><h2 id="process-title">De una idea a <em>un recuerdo.</em></h2></div>
        <p>Nos encargamos de transformar la esencia de tu celebración en una invitación que da gusto abrir y compartir.</p>
      </div>
      <div class="studio-process__grid">
        <div class="studio-process__step"><span>01</span><h3>Cuéntanos tu idea</h3><p>Nos compartes tu evento, los colores y el estilo que te gustaría transmitir.</p></div>
        <div class="studio-process__step"><span>02</span><h3>Lo hacemos especial</h3><p>Damos vida a una experiencia digital cuidando los detalles que hacen la diferencia.</p></div>
        <div class="studio-process__step"><span>03</span><h3>Comparte la emoción</h3><p>Comparte tu invitación con las personas que quieres tener a tu lado.</p></div>
      </div>
    </div>
  </section>

  <section class="catalog-contact" id="cotizacion">
    <div class="wrap catalog-contact__inner">
      <div><span class="eyebrow">TU HISTORIA MERECE ALGO ÚNICO</span><h2>Hagámosla <em>inolvidable.</em></h2><p>Una fecha especial merece una primera impresión igual de especial. Cuéntanos qué estás imaginando.</p></div>
      <div class="catalog-contact__cta"><a class="button button--cream" href={contactHref('Hola, CAZAMI. Vi su catálogo y quiero cotizar una invitación digital personalizada.')} target="_blank" rel="noopener noreferrer">Cotizar mi invitación <UiIcon name="external" size={17}/></a><small>Atención personalizada por WhatsApp</small></div>
    </div>
  </section>

  <script>
    type ExtraInvite = {id:string;name:string;category:string;url:string;cover?:string;createdAt?:string};
    type ExtraPass = {id:string;image:string};
    const grid=document.getElementById('works-grid');
    const count=document.getElementById('portfolio-count');
    const empty=document.getElementById('portfolio-empty');
    const search=document.getElementById('work-search') as HTMLInputElement|null;
    const filterButtons=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    let category='Todas';
    let page=1;
    const pageSize=9;
    const prevButton=document.getElementById('invite-prev') as HTMLButtonElement|null;
    const nextButton=document.getElementById('invite-next') as HTMLButtonElement|null;
    const pageLabel=document.getElementById('invite-page-label');
    function redraw(){
      const q=(search?.value||'').trim().toLocaleLowerCase('es-MX');
      const matches=Array.from(grid?.querySelectorAll<HTMLElement>('[data-work-card]')||[]).filter(card=>
        (category==='Todas'||category===card.dataset.category)&&(card.dataset.search||'').includes(q));
      const pages=Math.max(1,Math.ceil(matches.length/pageSize));
      page=Math.min(Math.max(page,1),pages);
      const start=(page-1)*pageSize;
      const visible=new Set(matches.slice(start,start+pageSize));
      grid?.querySelectorAll<HTMLElement>('[data-work-card]').forEach(card=>{
        card.hidden=!visible.has(card);
        if(visible.has(card))card.classList.add('visible');
      });
      if(count)count.textContent=`MOSTRANDO ${matches.length?start+1:0}–${Math.min(start+pageSize,matches.length)} DE ${matches.length} INVITACIONES`;
      if(empty)empty.hidden=matches.length>0;
      if(pageLabel)pageLabel.textContent=`Página ${page} de ${pages}`;
      if(prevButton)prevButton.disabled=page<=1;
      if(nextButton)nextButton.disabled=page>=pages;
    }
    filterButtons.forEach(button=>button.addEventListener('click',()=>{
      category=button.dataset.filter||'Todas';page=1;
      filterButtons.forEach(b=>{const active=b===button;b.classList.toggle('filterbtn--active',active);b.setAttribute('aria-pressed',String(active));});redraw();
    }));
    search?.addEventListener('input',()=>{page=1;redraw();});
    const goPage=(delta:number)=>{page+=delta;redraw();document.getElementById('coleccion')?.scrollIntoView({behavior:'smooth',block:'start'});};
    prevButton?.addEventListener('click',()=>goPage(-1));
    nextButton?.addEventListener('click',()=>goPage(1));
    function addInvite(item:ExtraInvite,index:number){
      if(!grid||!item.url.startsWith('https://')||!item.id)return;
      const article=document.createElement('article');
      const recent=Boolean(item.createdAt&&Date.now()-Date.parse(item.createdAt)<45*86400000);
      article.className='work-card reveal visible'+(recent?' work-card--recent':'');
      article.dataset.workCard='';
      article.dataset.category=item.category;
      article.dataset.search=(item.name+' '+item.category).toLocaleLowerCase('es-MX');
      const link=document.createElement('a');
      link.className='work-card__cover';link.href=item.url;link.target='_blank';link.rel='noopener noreferrer';
      link.setAttribute('aria-label','Abrir invitación de '+item.name);
      const preview=document.createElement('div');
      preview.className='web-preview invitation-preview web-preview--card is-awaiting-preview';
      const placeholder=document.createElement('div');
      placeholder.className='invitation-preview__fallback invitation-preview__fallback--new';
      const brand=document.createElement('span');
      brand.className='invitation-preview__brand';brand.textContent='CAZAMI STUDIO';
      const eyebrow=document.createElement('span');
      eyebrow.className='invitation-preview__kind';eyebrow.textContent='INVITACIÓN DIGITAL';
      const name=document.createElement('strong');name.textContent=item.name;
      const hint=document.createElement('span');
      hint.className='invitation-preview__cta';hint.textContent='Explorar diseño';
      const status=document.createElement('span');
      status.className='invitation-preview__status';status.textContent='Preparando vista previa';
      placeholder.append(brand,eyebrow,name,hint,status);
      const image=document.createElement('img');
      image.className='web-preview__actual invitation-preview__screenshot';
      image.alt='Vista real de la invitación '+item.name;
      image.loading='lazy';image.decoding='async';
      const automatic='/invitation-previews/nuevo-'+item.id+'.jpg';
      const allowed=new Set(['/invitation-previews/nuevo-'+item.id+'.jpg','/invitation-previews/nuevo-'+item.id+'.png','/invitation-previews/nuevo-'+item.id+'.webp']);
      const manual=typeof item.cover==='string'&&allowed.has(item.cover)?item.cover:'';
      let retries=0;
      const delays=[20000,60000,150000,300000];
      image.onload=()=>{image.hidden=false;preview.classList.remove('is-awaiting-preview');status.hidden=true;};
      image.onerror=()=>{
        image.hidden=true;preview.classList.add('is-awaiting-preview');status.hidden=false;
        if(manual&&image.src.includes(manual)){image.src=automatic;return;}
        if(retries>=delays.length){status.textContent='Vista en preparación · abrir invitación';return;}
        const delay=delays[retries++];
        window.setTimeout(()=>{
          if(!image.isConnected)return;
          image.hidden=false;image.src=automatic+'?actualizar='+Date.now();
        },delay);
      };
      const blocker=document.createElement('div');blocker.className='web-preview__blocker';
      preview.append(placeholder,image,blocker);
      const ordinal=document.createElement('span');
      ordinal.className='work-card__ordinal';ordinal.textContent=String(index+1).padStart(2,'0');
      const newBadge=document.createElement('span');
      newBadge.className='work-card__new';newBadge.textContent='NUEVA';
      link.append(preview,ordinal);if(recent)link.append(newBadge);
      const info=document.createElement('div');info.className='work-card__info';
      const type=document.createElement('p');type.className='eyebrow';type.textContent=item.category;
      const title=document.createElement('h3');title.textContent=item.name;
      const actions=document.createElement('div');actions.className='work-card__links';
      const open=document.createElement('a');
      open.href=item.url;open.target='_blank';open.rel='noopener noreferrer';open.textContent='Ver invitación';
      actions.append(open);info.append(type,title,actions);article.append(link,info);
      grid.prepend(article);image.src=manual||automatic;
    }
    fetch('/data/catalogo-adicional.json',{cache:'no-store'}).then(async response=>{
      if(!response.ok)return;
      const extra=await response.json() as {invitaciones?:ExtraInvite[];pases?:ExtraPass[]};
      const initial=grid?.querySelectorAll('[data-work-card]').length||0;
      // El JSON conserva el orden de alta: cada invitación se añade al inicio
      // para que la última publicada aparezca antes de las anteriores.
      // Orden de alta: la última invitación guardada queda al principio.
      const ordered=(extra.invitaciones||[]).map((item,i)=>({item,i})).sort((a,b)=>{
        const ta=Date.parse(a.item.createdAt||'')||0;
        const tb=Date.parse(b.item.createdAt||'')||0;
        return ta&&tb?ta-tb:a.i-b.i;
      });
      ordered.forEach(({item},i)=>addInvite(item,initial+i));
      // Actualizar las piezas editoriales con las tres publicaciones más recientes.
      ordered.slice().reverse().slice(0,3).forEach(({item},i)=>{
        if(!/^[0-9a-f-]{36}$/i.test(item.id))return;
        const featured=document.querySelector<HTMLAnchorElement>('[data-feature="'+i+'"]');
        const picture=featured?.querySelector<HTMLImageElement>('[data-feature-img]');
        const name=featured?.querySelector<HTMLElement>('[data-feature-name]');
        const categoryLabel=featured?.querySelector<HTMLElement>('[data-feature-category]');
        if(!featured||!picture||!name||!categoryLabel||!item.url.startsWith('https://'))return;
        const prefix='/invitation-previews/nuevo-'+item.id+'.';
        const source=typeof item.cover==='string'&&['jpg','webp','png'].some(ext=>item.cover===prefix+ext)
          ?item.cover:prefix+'jpg';
        const probe=new Image();
        probe.onload=()=>{
          picture.src=source;
          picture.alt='Vista previa de '+item.name;
          featured.href=item.url;
          featured.setAttribute('aria-label','Explorar la invitación '+item.name);
          name.textContent=item.name;
          categoryLabel.textContent=item.category;
        };
        probe.src=source;
      });
      // Mostrar los diseños recientes en la portada sin arriesgar las imágenes de respaldo.
      const heroSlots=['center','left','right'];
      ordered.slice().reverse().slice(0,3).forEach(({item},i)=>{
        if(!/^[0-9a-f-]{36}$/i.test(item.id))return;
        const frame=document.querySelector<HTMLElement>('[data-hero-preview="'+heroSlots[i]+'"]');
        const target=frame?.querySelector<HTMLImageElement>('img');
        const label=frame?.querySelector<HTMLElement>('.hero-art__name');
        if(!target||!label)return;
        const prefix='/invitation-previews/nuevo-'+item.id+'.';
        const path=typeof item.cover==='string'&&['jpg','png','webp'].some(ext=>item.cover===prefix+ext)
          ?item.cover:prefix+'jpg';
        const probe=new Image();
        probe.onload=()=>{target.src=path;target.alt='Vista real de '+item.name;label.textContent=item.name;};
        probe.src=path;
      });

      grid?.querySelectorAll<HTMLElement>('[data-work-card]').forEach((card,i)=>{
        const ordinal=card.querySelector<HTMLElement>('.work-card__ordinal');
        if(ordinal)ordinal.textContent=String(i+1).padStart(2,'0');
      });
      const rail=document.getElementById('passes-rail');
      (extra.pases||[]).forEach((pass)=>{
        if(!rail||!/^\/passes\/nuevos\/[a-z0-9-]+\.(?:png|jpe?g|webp)$/i.test(pass.image))return;
        const fig=document.createElement('figure');fig.className='pass-card';
        const button=document.createElement('button');button.type='button';button.className='pass-card__image';button.dataset.viewPass='';button.dataset.img=pass.image;button.dataset.name='Pase digital';button.setAttribute('aria-label','Ampliar pase digital');
        const mockup=document.createElement('span');mockup.className='pass-card__mockup';const img=document.createElement('img');img.src=pass.image;img.loading='lazy';img.alt='Pase digital realizado por CAZAMI';mockup.append(img);
        const zoom=document.createElement('span');zoom.className='pass-card__zoom';zoom.textContent='Ver pase';button.append(mockup,zoom);fig.append(button);rail.append(fig);
      });redraw();
    }).catch(()=>{/* Las muestras originales continúan visibles sin conexión. */});
    redraw();

  </script>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LivePreview from '../../components/LivePreview.astro';
import Icon from '../../components/Icon.astro';
import {catalog,type Invite} from '../../data/catalog';
import {contactHref} from '../../data/site';
export function getStaticPaths(){return catalog.map(item=>({params:{slug:item.slug},props:{item}}));}
interface Props{item:Invite}
const {item}=Astro.props;
const related=catalog.filter(other=>other.slug!==item.slug&&other.category===item.category).slice(0,3);
---
<BaseLayout title={`${item.name} · CAZAMI STUDIO`} description={`Explora la demostración original de la invitación web ${item.name}, diseñada por CAZAMI STUDIO.`}>
<section class="detail"><div class="shell"><div class="detail__breadcrumb"><a href="/#coleccion"><Icon name="arrow" size={17}/> Volver al portafolio</a><span>CAZAMI / PROYECTO REAL</span></div><div class="detail__layout"><div class="detail__copy rise"><p class="kicker">{item.category} · INVITACIÓN WEB</p><h1>{item.name}<em>.</em></h1><p class="detail__sub">{item.subtitle}</p><p>{item.description}</p><p>Para ver la invitación funcionando, abre la demostración original. Los ejemplos de pases digitales se presentan por separado en la sección de pases.</p><div class="detail__buttons"><a class="btn btn--ink" href={item.externalDemo} target="_blank" rel="noopener noreferrer">Abrir demo original <Icon name="arrowUp" size={19}/></a><a class="text-link" href={contactHref(`Hola, CAZAMI. Me gustaría cotizar una invitación web inspirada en ${item.name}.`)} target="_blank" rel="noopener noreferrer">Cotizar diseño <Icon name="arrow" size={17}/></a></div></div><div class="detail__visual rise"><LivePreview item={item} context="detail"/><small>VISTA PREVIA DEL PROYECTO · ABRE LA DEMOSTRACIÓN ORIGINAL</small></div></div></div></section>
{related.length>0&&<section class="detail__related"><div class="shell"><div class="section-meta"><span>OTROS PROYECTOS</span><span>{item.category}</span></div><h2>Sigue <em>descubriendo.</em></h2><div class="detail__related-grid">{related.map(other=><a href={`/invitacion/${other.slug}/`}><span>{other.category}</span><strong>{other.name}</strong><span>Conocer el proyecto <Icon name="arrowUp" size={14}/></span></a>)}</div></div></section>}
<section class="detail__end"><div class="shell"><p class="kicker kicker--light">LA SIGUIENTE HISTORIA PUEDE SER TUYA</p><h2>Diseñemos algo <em>inolvidable.</em></h2><a class="btn btn--light" href={contactHref('Hola, CAZAMI. Quiero una cotización personalizada.')} target="_blank" rel="noopener noreferrer">Escribir a CAZAMI <Icon name="arrowUp" size={19}/></a></div></section>
</BaseLayout>

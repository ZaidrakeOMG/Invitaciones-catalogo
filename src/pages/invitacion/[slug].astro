---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LivePreview from '../../components/LivePreview.astro';
import {catalog,type Invite} from '../../data/catalog';
import {contactHref} from '../../data/site';
export function getStaticPaths(){return catalog.map(item=>({params:{slug:item.slug},props:{item}}));}
interface Props {item:Invite}
const {item}=Astro.props;
const related=catalog.filter(other=>other.slug!==item.slug&&other.category===item.category).slice(0,3);
---
<BaseLayout title={`${item.name} · Portafolio CAZAMI STUDIO`} description={`Descubre la invitación digital de ${item.name}. Demostración real y cotización personalizada de CAZAMI.`}>
<section class="detail-intro section-space"><div class="wrap"><div class="detail-intro__meta"><a href="/#coleccion">← Volver al portafolio</a><span>{item.category} / DEMOSTRACIÓN WEB ORIGINAL</span></div><div class="detail-intro__grid"><div class="detail-intro__copy"><span class="eyebrow">CAZAMI · TRABAJO DEL ESTUDIO</span><h1 class="display-title">{item.name}<em>.</em></h1><p class="lead">{item.subtitle}</p><p>{item.description}</p><p>Esta página muestra la invitación web y enlaza a su demostración original. No es una muestra de pase digital.</p><div class="detail-intro__actions"><a href={item.externalDemo} target="_blank" rel="noopener noreferrer" class="button button--ink">Abrir invitación completa ↗</a><a href={contactHref(`Hola, CAZAMI. Quiero cotizar una invitación web inspirada en ${item.name}.`)} target="_blank" rel="noopener noreferrer" class="text-arrow">Solicitar cotización ↗</a></div></div><div class="detail-intro__media"><div class="detail-intro__browser"><div class="detail-intro__browser-top"><span>● ● ●</span><b>CAZAMI / VISTA SIN INTERACCIÓN</b></div><LivePreview item={item} context="detail" /></div><span class="detail-intro__media-note">{item.cover?'CAPTURA REAL DE LA PORTADA':'LA DEMOSTRACIÓN SE INTEGRA SOLO SI SU SITIO LO PERMITE'}</span></div></div></div></section>
<section class="detail-context section-space"><div class="wrap"><div class="section-bar"><span>UNA EXPERIENCIA DIGITAL</span><span>INVITACIÓN WEB · NO PASE DIGITAL</span></div><div class="detail-context__grid"><h2 class="display-title">Conoce el <em>proyecto original.</em></h2><div><p>Las vistas de este catálogo están bloqueadas para que no reproduzcan música, abran menús o ejecuten formularios por accidente. Usa el botón para abrir el sitio y recorrerlo libremente.</p><p>Las características y extras de una nueva invitación se definen contigo al solicitar la cotización; no todas las demostraciones contienen las mismas funciones.</p><a href={item.externalDemo} target="_blank" rel="noopener noreferrer" class="button button--ink">Ir a la demostración ↗</a></div></div></div></section>
{related.length>0 && <section class="detail-related section-space"><div class="wrap"><div class="section-bar"><span>OTROS TRABAJOS</span><span>{item.category}</span></div><h2 class="display-title">Sigue <em>descubriendo.</em></h2><div class="detail-related__grid">{related.map((other,index)=><a class="detail-related__item" href={`/invitacion/${other.slug}/`}><span>0{index+1} / {other.category}</span><b>{other.name}</b><small>{other.subtitle}</small><span aria-hidden="true">↗</span></a>)}</div></div></section>}
<section class="detail-last"><div class="wrap"><span class="eyebrow">TU SIGUIENTE GRAN IDEA</span><h2 class="display-title">Diseñemos una entrada <em>inolvidable.</em></h2><a class="button button--cream" href={contactHref(`Hola, CAZAMI. Me gustaría cotizar una invitación para mi evento. Vi la muestra de ${item.name}.`)} target="_blank" rel="noopener noreferrer">Contactar a CAZAMI ↗</a></div></section>
<script>
 const previews=Array.from(document.querySelectorAll<HTMLElement>('[data-web-preview]'));
 const activate=(host:HTMLElement)=>{const iframe=host.querySelector<HTMLIFrameElement>('iframe[data-src]');if(!iframe||iframe.hasAttribute('src'))return;const w=host.getBoundingClientRect().width;iframe.style.transform=`scale(${w/390})`;iframe.src=iframe.dataset.src||'';};
 if('ResizeObserver' in window){const ro=new ResizeObserver(entries=>entries.forEach(e=>{const f=e.target.querySelector<HTMLIFrameElement>('iframe[data-src]');if(f)f.style.transform=`scale(${e.contentRect.width/390})`;}));previews.forEach(h=>ro.observe(h));}
 if('IntersectionObserver' in window){const io=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){activate(e.target as HTMLElement);io.unobserve(e.target);}}),{rootMargin:'300px 0px'});previews.forEach(h=>io.observe(h));}else previews.forEach(activate);
</script>
</BaseLayout>

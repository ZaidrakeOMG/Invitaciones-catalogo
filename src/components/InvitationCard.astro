---
import type { Invite } from '../data/catalog';
import LivePreview from './LivePreview.astro';
import UiIcon from './UiIcon.astro';
interface Props {item:Invite;index:number}
const {item,index}=Astro.props;
---
<article class="work-card reveal" data-work-card data-category={item.category} data-search={`${item.name} ${item.category}`.toLocaleLowerCase('es-MX')}>
  <a class="work-card__cover" href={item.externalDemo} target="_blank" rel="noopener noreferrer" aria-label={`Abrir invitación de ${item.name}`}><LivePreview item={item}/><span class="work-card__ordinal">{String(index+1).padStart(2,'0')}</span></a>
  <div class="work-card__info"><p class="eyebrow">{item.category}</p><h3>{item.name}</h3><div class="work-card__links"><a href={item.externalDemo} target="_blank" rel="noopener noreferrer">Abrir invitación <UiIcon name="external" size={14}/></a></div></div>
</article>

---
const passes=[
 '/passes/aislinn-jose.webp','/passes/scarlett-marisol.webp','/passes/romina-manola.webp',
 '/passes/bernardo.webp','/passes/mayte.webp','/passes/valeria-elizabeth.webp',
];
---
<section class="passes-section section-space" id="pases" aria-labelledby="passes-title"><div class="wrap">
  <div class="section-bar section-bar--inverse"><span>02 / NUESTROS TRABAJOS</span><span>PASES DIGITALES</span></div>
  <div class="passes-header passes-header--simple"><div><span class="passes-kicker">✦ PEQUEÑOS DETALLES, GRANDES MOMENTOS</span><h2 class="display-title" id="passes-title">Pases que <em>hemos hecho.</em></h2><p class="lead">Diseños únicos para cada celebración.</p></div></div>
  <div class="passes-grid" id="passes-rail" aria-label="Galería de pases digitales">
    {passes.map((img)=><figure class="pass-card"><button class="pass-card__image" type="button" data-view-pass data-img={img} data-name="Pase digital" aria-label="Ampliar pase digital"><span class="pass-card__mockup"><img src={img} loading="lazy" decoding="async" alt="Diseño de pase digital CAZAMI" /></span><span class="pass-card__zoom">VER COMPLETO ↗</span></button></figure>)}
  </div>
  <nav class="catalog-pagination catalog-pagination--dark" id="passes-pagination" aria-label="Páginas de pases">
    <button type="button" id="passes-prev" class="catalog-pagination__button" disabled>← Anterior</button>
    <span id="passes-page-label" class="catalog-pagination__label" role="status" aria-live="polite">Página 1 de 1</span>
    <button type="button" id="passes-next" class="catalog-pagination__button" disabled>Siguiente →</button>
  </nav>
</div>
<dialog class="pass-dialog" id="pass-dialog" aria-label="Pase digital ampliado"><button type="button" id="pass-dialog-close" aria-label="Cerrar pase">Cerrar ×</button><img id="pass-dialog-image" alt="Pase digital CAZAMI" /></dialog>
</section>
<script>
 const rail=document.getElementById('passes-rail');
 let page=1;
 const pageSize=9;
 const prevButton=document.getElementById('passes-prev') as HTMLButtonElement|null;
 const nextButton=document.getElementById('passes-next') as HTMLButtonElement|null;
 const pageLabel=document.getElementById('passes-page-label');
 const redraw=()=>{
  const cards=Array.from(rail?.querySelectorAll<HTMLElement>('.pass-card')||[]);
  const pages=Math.max(1,Math.ceil(cards.length/pageSize));
  page=Math.min(Math.max(1,page),pages);
  const start=(page-1)*pageSize;
  cards.forEach((card,index)=>{card.hidden=index<start||index>=start+pageSize;});
  if(prevButton)prevButton.disabled=page===1;
  if(nextButton)nextButton.disabled=page===pages;
  if(pageLabel)pageLabel.textContent=`Página ${page} de ${pages}`;
 };
 const goPage=(delta:number)=>{page+=delta;redraw();document.getElementById('pases')?.scrollIntoView({behavior:'smooth',block:'start'});};
 prevButton?.addEventListener('click',()=>goPage(-1));
 nextButton?.addEventListener('click',()=>goPage(1));
 if(rail){new MutationObserver(redraw).observe(rail,{childList:true});redraw();}
 const dialog=document.getElementById('pass-dialog') as HTMLDialogElement|null;
 const image=document.getElementById('pass-dialog-image') as HTMLImageElement|null;
 // Delegación: también funciona con nuevos pases cargados desde el administrador.
 rail?.addEventListener('click',(event)=>{const button=(event.target as HTMLElement).closest<HTMLButtonElement>('[data-view-pass]');if(!button||!dialog||!image)return;image.src=button.dataset.img||'';dialog.showModal();});
 document.getElementById('pass-dialog-close')?.addEventListener('click',()=>dialog?.close());
 dialog?.addEventListener('click',event=>{if(event.target===dialog)dialog.close();});
</script>

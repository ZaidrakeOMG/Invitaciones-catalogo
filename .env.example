# Para el panel /admin/ se necesitan estas variables SECRETAS en Vercel.
# Ejecutar: node scripts/generar-claves-admin.mjs 2525
ADMIN_PASSWORD_SCRYPT=
ADMIN_SESSION_SECRET=
# Crear un Fine-grained personal access token en GitHub (Contents: Read and write).
GITHUB_TOKEN=
# Repositorio de GitHub en formato usuario/repositorio.
GITHUB_REPO=ZaidrakeOMG/Invitaciones-catalogo
GITHUB_BRANCH=main
# URL del dominio de producción, si existe.
PUBLIC_SITE_URL=
